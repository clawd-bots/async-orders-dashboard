{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ts5tSu9qM8jVEJ2ArwpRZR","type":"tool_result","content":"    40→    fetch('/api/status')\n    41→      .then(r => r.json())\n    42→      .then(data => {\n    43→        setConfigured(data.configured);\n    44→        if (data.configured) {\n    45→          fetchOrders();\n    46→          fetchMetrics();\n    47→        }\n    48→      })\n    49→      .catch(() => setConfigured(false));\n    50→  }, []);\n    51→\n    52→  const fetchOrders = async () => {\n    53→    setLoading(true);\n    54→    setMessage(null);\n    55→    try {\n    56→      const res = await fetch('/api/orders');\n    57→      const data = await res.json();\n    58→      if (data.error) {\n    59→        setMessage({ type: 'error', text: data.error });\n    60→      } else {\n    61→        const approved = data.approved?.orders || [];\n    62→        setApprovedOrders(approved);\n    63→        setApprovedSummary(data.approved?.summary);\n    64→        setNotApprovedOrders(data.notApproved?.orders || []);\n    65→        setNotApprovedSummary(data.notApproved?.summary);\n    66→        setLastFetch(new Date().toLocaleString());\n    67→        fetchBatches(approved);\n    68→        const ac = data.approved?.summary?.count || 0;\n    69→        const nc = data.notApproved?.summary?.count || 0;\n    70→        setMessage({ type: 'success', text: `Found ${ac} approved, ${nc} not approved` });\n    71→      }\n    72→    } catch (e) {\n    73→      setMessage({ type: 'error', text: e.message });\n    74→    }\n    75→    setLoading(false);\n    76→  };\n    77→\n    78→  const fetchMetrics = async () => {\n    79→    setMetricsLoading(true);\n    80→    try {\n    81→      const res = await fetch('/api/metrics');\n    82→      const data = await res.json();\n    83→      if (!data.error) setMetrics(data);\n    84→    } catch (e) { /* silent */ }\n    85→    setMetricsLoading(false);\n    86→  };\n    87→\n    88→  const fetchBatches = async (orders) => {\n    89→    if (!supabase || orders.length === 0) return;\n    90→    try {\n    91→      const skus = [...new Set(orders.flatMap(o => (o.line_items || []).map(li => li.sku).filter(Boolean)))];\n    92→      if (skus.length === 0) return;\n    93→\n    94→      const { data: products } = await supabase\n    95→        .from('shopify_products')\n    96→        .select('id, sku')\n    97→        .in('sku', skus);\n    98→      if (!products || products.length === 0) return;\n    99→\n   100→      const skuToProductId = {};\n   101→      for (const p of products) skuToProductId[p.sku] = p.id;\n   102→      const productIds = [...new Set(Object.values(skuToProductId))];\n   103→\n   104→      const { data: batches } = await supabase\n   105→        .from('product_batches')\n   106→        .select('product_id, batch_number, expiry_date, quantity')\n   107→        .in('product_id', productIds)\n   108→        .gt('quantity', 0)\n   109→        .order('expiry_date', { ascending: true });\n   110→      if (!batches) return;\n   111→\n   112→      const productIdToSku = {};\n   113→      for (const [sku, pid] of Object.entries(skuToProductId)) {\n   114→        if (!productIdToSku[pid]) productIdToSku[pid] = [];\n   115→        productIdToSku[pid].push(sku);\n   116→      }\n   117→\n   118→      const map = {};\n   119→      for (const b of batches) {\n   120→        const skusForProduct = productIdToSku[b.product_id] || [];\n   121→        for (const sku of skusForProduct) {\n   122→          if (!map[sku]) map[sku] = [];\n   123→          map[sku].push({ batch_number: b.batch_number, expiry_date: b.expiry_date, quantity: b.quantity });\n   124→        }\n   125→      }\n   126→      setBatchMap(map);\n   127→    } catch (e) {\n   128→      console.error('Failed to fetch batches:', e);\n   129→    }\n   130→  };\n   131→\n   132→  const sendEmail = async () => {\n   133→    setSending(true);\n   134→    setMessage(null);\n   135→    try {\n   136→      const res = await fetch('/api/send-email', { method: 'POST' });\n   137→      const data = await res.json();\n   138→      if (data.error) setMessage({ type: 'error', text: data.error });\n   139→      else setMessage({ type: 'success', text: data.message || 'Email sent!' });\n   140→    } catch (e) {\n   141→      setMessage({ type: 'error', text: e.message });\n   142→    }\n   143→    setSending(false);\n   144→  };\n   145→\n   146→  const downloadCSV = () => {\n   147→    const csvOrders = activeTab === 'approved' ? approvedOrders : notApprovedOrders;\n   148→    if (csvOrders.length === 0) return;\n   149→\n   150→    let headers, rows;\n   151→    if (activeTab === 'approved') {\n   152→      const csvAllocations = allocateBatches(csvOrders);\n   153→      let allocIdx = 0;\n   154→      headers = ['Order Number', 'Date', 'Customer', 'Phone', 'Product', 'SKU', 'Qty', 'Batch', 'Batch Expiry', 'Shipping Address', 'Provincial', 'Preferred Delivery', 'Delivery Date', 'Approved On', 'Since Approval', 'Shipped'];\n   155→      rows = csvOrders.flatMap(o =>\n   156→        (o.line_items?.length > 0 ? o.line_items : [{ title: '', sku: '', quantity: 0 }]).flatMap(item =>\n   157→          Array.from({ length: Math.max(item.quantity || 1, 1) }, () => {\n   158→            const alloc = csvAllocations[allocIdx++];\n   159→            return [\n   160→              o.name,\n   161→              new Date(o.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' }),\n   162→              `${o.customer?.first_name || ''} ${o.customer?.last_name || ''}`.trim(),\n   163→              o.shipping_address?.phone || '',\n   164→              item.title || '',\n   165→              item.sku || '',\n   166→              1,\n   167→              alloc ? alloc.batch_number : 'No stock',\n   168→              alloc ? alloc.expiry_date : '',\n   169→              o.shipping_address ? `${o.shipping_address.address1}, ${o.shipping_address.city}, ${o.shipping_address.province} ${o.shipping_address.zip}` : '',\n   170→              o.is_provincial ? 'Yes' : 'No',\n   171→              o.preferred_delivery === true ? 'Yes' : o.preferred_delivery === false ? 'No' : '',\n   172→              o.preferred_delivery_date || '',\n   173→              getEffectiveApprovalDate(o) ? new Date(getEffectiveApprovalDate(o)).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) : '',\n   174→              getHoursAgo(getEffectiveApprovalDate(o)),\n   175→              'No',\n   176→            ];\n   177→          })\n   178→        )\n   179→      );\n   180→    } else {\n   181→      headers = ['Order Number', 'Date', 'Customer', 'Email', 'Product', 'SKU', 'Qty', 'Prescription Status', 'Total'];\n   182→      rows = csvOrders.flatMap(o =>\n   183→        (o.line_items?.length > 0 ? o.line_items : [{ title: '', sku: '', quantity: 0 }]).flatMap(item =>\n   184→          Array.from({ length: Math.max(item.quantity || 1, 1) }, () => [\n   185→            o.name,\n   186→            new Date(o.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' }),\n   187→            `${o.customer?.first_name || ''} ${o.customer?.last_name || ''}`.trim(),\n   188→            o.customer?.email || '',\n   189→            item.title || '',\n   190→            item.sku || '',\n   191→            1,\n   192→            o.prescription_status || '',\n   193→            `${o.currency} ${parseFloat(o.total_price || 0).toLocaleString()}`,\n   194→          ])\n   195→        )\n   196→      );\n   197→    }\n   198→\n   199→    const csv = [headers, ...rows].map(r => r.map(c => `\"${(c || '').toString().replace(/\"/g, '\"\"')}\"`).join(',')).join('\\n');\n   200→    const blob = new Blob([csv], { type: 'text/csv' });\n   201→    const url = URL.createObjectURL(blob);\n   202→    const a = document.createElement('a');\n   203→    a.href = url;\n   204→    a.download = `fulfillment-${activeTab}-${new Date().toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' }).replace(/\\//g, '-')}.csv`;\n   205→    a.click();\n   206→  };\n   207→\n   208→  const getHoursAgo = (dateStr) => {\n   209→    if (!dateStr) return '—';\n   210→    const hrs = (new Date() - new Date(dateStr)) / (1000 * 60 * 60);\n   211→    if (hrs < 1) return '<1h';\n   212→    if (hrs < 24) return `${Math.floor(hrs)}h`;\n   213→    const days = Math.floor(hrs / 24);\n   214→    const remHrs = Math.floor(hrs % 24);\n   215→    return `${days}d ${remHrs}h`;\n   216→  };\n   217→\n   218→  // New tile structure logic\n   219→  // Check if order was auto-approved (within 5 min of creation) AND has scheduled consultation\n   220→  const isAwaitingConsultation = (o) => {\n   221→    if (!o.consultation_status || o.consultation_status.toLowerCase() !== 'scheduled') return false;\n   222→    // Only hold if approved within 5 minutes of order creation (auto-approval)\n   223→    // If manually approved (>5 min), someone already reviewed it — ship normally\n   224→    if (!o.approved_at || !o.created_at) return true; // no approval time = treat as auto\n   225→    const created = new Date(o.created_at).getTime();\n   226→    const approved = new Date(o.approved_at).getTime();\n   227→    const diffMinutes = (approved - created) / (1000 * 60);\n   228→    return diffMinutes <= 5;\n   229→  };\n   230→\n   231→  const getTileCounts = () => {\n   232→    const now = new Date();\n   233→    const phtNow = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n   234→    const phtDay = phtNow.getDay(); // 0=Sun\n   235→\n   236→    if (phtDay === 0) return { shipToday: 0, overdue: 0, scheduled: 0, newOrders: 0, awaitingConsult: 0, pending: 0 };\n   237→\n   238→    // Today's date for comparison (YYYY-MM-DD in PHT)\n   239→    const todayPHT = new Date(phtNow.getFullYear(), phtNow.getMonth(), phtNow.getDate());\n   240→\n   241→    // \"Previous business day\" cutoffs in PHT\n   242→    // If today is Monday (1), previous business day is Saturday (not Sunday)\n   243→    // If today is Sunday (0), we already returned zeros above\n   244→    const prevBizDayOffset = phtDay === 1 ? 2 : 1; // Mon → go back 2 days (Sat), else go back 1 day\n   245→\n   246→    // Cutoff hours: 7:30 AM for all orders, 12 noon for sexual health (Erectile Dysfunction)\n   247→    const defaultCutoffHour = 7.5; // 7:30 AM\n   248→    const sexualHealthCutoffHour = 12; // 12 noon\n   249→\n   250→    // Helper: check if order contains sexual health products\n   251→    const isSexualHealthOrder = (o) => (o.line_items || []).some(li =>\n   252→      (li.product_type || '').toLowerCase().includes('erectile dysfunction')\n   253→    );\n   254→\n   255→    // Helper: get cutoff times for a given hour (supports half hours)\n   256→    const makeCutoff = (baseDate, hour) => {\n   257→      const d = new Date(baseDate);\n   258→      d.setHours(Math.floor(hour), (hour % 1) * 60, 0, 0);\n   259→      return d;\n   260→    };\n   261→\n   262→    const yesterdayDefault = makeCutoff(new Date(phtNow.getTime() - prevBizDayOffset * 86400000), defaultCutoffHour);\n   263→    const yesterdaySexHealth = makeCutoff(new Date(phtNow.getTime() - prevBizDayOffset * 86400000), sexualHealthCutoffHour);\n   264→    const todayDefault = makeCutoff(phtNow, defaultCutoffHour);\n   265→    const todaySexHealth = makeCutoff(phtNow, sexualHealthCutoffHour);\n   266→\n   267→    let shipToday = 0; // Orders due TODAY only (not overdue)\n   268→    let overdue = 0;   // Orders that should have shipped on a PREVIOUS day\n   269→    let scheduled = 0;\n   270→    let newOrders = 0;\n   271→    let awaitingConsult = 0;\n   272→\n   273→    for (const o of approvedOrders) {\n   274→      // Orders with \"Scheduled\" consultation status are held — don't ship yet\n   275→      if (isAwaitingConsultation(o)) {\n   276→        awaitingConsult++;\n   277→        continue;\n   278→      }\n   279→      if (o.preferred_delivery_date) {\n   280→        // Orders WITH delivery date\n   281→        const deliveryDate = new Date(o.preferred_delivery_date + 'T00:00:00');\n   282→        const deliveryDatePHT = new Date(deliveryDate.toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n   283→        const deliveryDateOnly = new Date(deliveryDatePHT.getFullYear(), deliveryDatePHT.getMonth(), deliveryDatePHT.getDate());\n   284→        \n   285→        if (deliveryDateOnly < todayPHT) {\n   286→          // Delivery date is past → overdue only (not Ship Today)\n   287→          overdue++;\n   288→        } else if (deliveryDateOnly.getTime() === todayPHT.getTime()) {\n   289→          // Delivery date is today → Ship Today\n   290→          shipToday++;\n   291→        } else {\n   292→          // Delivery date is future → scheduled\n   293→          scheduled++;\n   294→        }\n   295→      } else {\n   296→        // Orders WITHOUT delivery date: use cutoff logic\n   297→        const ref = getEffectiveApprovalDate(o);\n   298→        const approvedPHT = new Date(new Date(ref).toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n   299→        const isSH = isSexualHealthOrder(o);\n   300→        const yesterdayCutoff = isSH ? yesterdaySexHealth : yesterdayDefault;\n   301→        const todayCutoff = isSH ? todaySexHealth : todayDefault;\n   302→\n   303→        if (approvedPHT < yesterdayCutoff) {\n   304→          // Approved before previous business day's cutoff → overdue\n   305→          overdue++;\n   306→        } else if (approvedPHT < todayCutoff) {\n   307→          // Approved between previous biz day's cutoff and today's cutoff → Ship Today\n   308→          shipToday++;\n   309→        } else {\n   310→          // Approved after today's cutoff → new (due tomorrow)\n   311→          newOrders++;\n   312→        }\n   313→      }\n   314→    }\n   315→\n   316→    const pending = shipToday + overdue + scheduled + newOrders + awaitingConsult;\n   317→    return { shipToday, overdue, scheduled, newOrders, awaitingConsult, pending };\n   318→  };\n   319→\n   320→  // Helper function to get the effective approval date\n   321→  // For orders that went through consultation: use consultation completion time\n   322→  // For others: later of approved_at vs created_at\n   323→  const getEffectiveApprovalDate = (order) => {\n   324→    // If order was auto-approved (within 5 min) and had a consultation that's now complete,\n   325→    // the real approval is when the consultation completed\n   326→    const cs = order.consultation_status?.toLowerCase();\n   327→    if (order.consultation_status_updated_at && cs && cs !== 'scheduled' && cs !== 'not required') {\n   328→      // Only use consultation time if it was auto-approved (within 5 min)\n   329→      const created = new Date(order.created_at).getTime();\n   330→      const approved = order.approved_at ? new Date(order.approved_at).getTime() : created;\n   331→      const diffMin = (approved - created) / (1000 * 60);\n   332→      if (diffMin <= 5) {\n   333→        return order.consultation_status_updated_at;\n   334→      }\n   335→    }\n   336→    \n   337→    const approvedAt = order.approved_at ? new Date(order.approved_at) : null;\n   338→    const createdAt = new Date(order.created_at);\n   339→    "}]},"parent_tool_use_id":null,"session_id":"652984ef-afb7-4f4d-8ebb-d98b5eef4f87","uuid":"88469eda-42e5-4ae7-ab54-591029503ac3","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/async-orders-dashboard/src/App.jsx","content":"    fetch('/api/status')\n      .then(r => r.json())\n      .then(data => {\n        setConfigured(data.configured);\n        if (data.configured) {\n          fetchOrders();\n          fetchMetrics();\n        }\n      })\n      .catch(() => setConfigured(false));\n  }, []);\n\n  const fetchOrders = async () => {\n    setLoading(true);\n    setMessage(null);\n    try {\n      const res = await fetch('/api/orders');\n      const data = await res.json();\n      if (data.error) {\n        setMessage({ type: 'error', text: data.error });\n      } else {\n        const approved = data.approved?.orders || [];\n        setApprovedOrders(approved);\n        setApprovedSummary(data.approved?.summary);\n        setNotApprovedOrders(data.notApproved?.orders || []);\n        setNotApprovedSummary(data.notApproved?.summary);\n        setLastFetch(new Date().toLocaleString());\n        fetchBatches(approved);\n        const ac = data.approved?.summary?.count || 0;\n        const nc = data.notApproved?.summary?.count || 0;\n        setMessage({ type: 'success', text: `Found ${ac} approved, ${nc} not approved` });\n      }\n    } catch (e) {\n      setMessage({ type: 'error', text: e.message });\n    }\n    setLoading(false);\n  };\n\n  const fetchMetrics = async () => {\n    setMetricsLoading(true);\n    try {\n      const res = await fetch('/api/metrics');\n      const data = await res.json();\n      if (!data.error) setMetrics(data);\n    } catch (e) { /* silent */ }\n    setMetricsLoading(false);\n  };\n\n  const fetchBatches = async (orders) => {\n    if (!supabase || orders.length === 0) return;\n    try {\n      const skus = [...new Set(orders.flatMap(o => (o.line_items || []).map(li => li.sku).filter(Boolean)))];\n      if (skus.length === 0) return;\n\n      const { data: products } = await supabase\n        .from('shopify_products')\n        .select('id, sku')\n        .in('sku', skus);\n      if (!products || products.length === 0) return;\n\n      const skuToProductId = {};\n      for (const p of products) skuToProductId[p.sku] = p.id;\n      const productIds = [...new Set(Object.values(skuToProductId))];\n\n      const { data: batches } = await supabase\n        .from('product_batches')\n        .select('product_id, batch_number, expiry_date, quantity')\n        .in('product_id', productIds)\n        .gt('quantity', 0)\n        .order('expiry_date', { ascending: true });\n      if (!batches) return;\n\n      const productIdToSku = {};\n      for (const [sku, pid] of Object.entries(skuToProductId)) {\n        if (!productIdToSku[pid]) productIdToSku[pid] = [];\n        productIdToSku[pid].push(sku);\n      }\n\n      const map = {};\n      for (const b of batches) {\n        const skusForProduct = productIdToSku[b.product_id] || [];\n        for (const sku of skusForProduct) {\n          if (!map[sku]) map[sku] = [];\n          map[sku].push({ batch_number: b.batch_number, expiry_date: b.expiry_date, quantity: b.quantity });\n        }\n      }\n      setBatchMap(map);\n    } catch (e) {\n      console.error('Failed to fetch batches:', e);\n    }\n  };\n\n  const sendEmail = async () => {\n    setSending(true);\n    setMessage(null);\n    try {\n      const res = await fetch('/api/send-email', { method: 'POST' });\n      const data = await res.json();\n      if (data.error) setMessage({ type: 'error', text: data.error });\n      else setMessage({ type: 'success', text: data.message || 'Email sent!' });\n    } catch (e) {\n      setMessage({ type: 'error', text: e.message });\n    }\n    setSending(false);\n  };\n\n  const downloadCSV = () => {\n    const csvOrders = activeTab === 'approved' ? approvedOrders : notApprovedOrders;\n    if (csvOrders.length === 0) return;\n\n    let headers, rows;\n    if (activeTab === 'approved') {\n      const csvAllocations = allocateBatches(csvOrders);\n      let allocIdx = 0;\n      headers = ['Order Number', 'Date', 'Customer', 'Phone', 'Product', 'SKU', 'Qty', 'Batch', 'Batch Expiry', 'Shipping Address', 'Provincial', 'Preferred Delivery', 'Delivery Date', 'Approved On', 'Since Approval', 'Shipped'];\n      rows = csvOrders.flatMap(o =>\n        (o.line_items?.length > 0 ? o.line_items : [{ title: '', sku: '', quantity: 0 }]).flatMap(item =>\n          Array.from({ length: Math.max(item.quantity || 1, 1) }, () => {\n            const alloc = csvAllocations[allocIdx++];\n            return [\n              o.name,\n              new Date(o.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' }),\n              `${o.customer?.first_name || ''} ${o.customer?.last_name || ''}`.trim(),\n              o.shipping_address?.phone || '',\n              item.title || '',\n              item.sku || '',\n              1,\n              alloc ? alloc.batch_number : 'No stock',\n              alloc ? alloc.expiry_date : '',\n              o.shipping_address ? `${o.shipping_address.address1}, ${o.shipping_address.city}, ${o.shipping_address.province} ${o.shipping_address.zip}` : '',\n              o.is_provincial ? 'Yes' : 'No',\n              o.preferred_delivery === true ? 'Yes' : o.preferred_delivery === false ? 'No' : '',\n              o.preferred_delivery_date || '',\n              getEffectiveApprovalDate(o) ? new Date(getEffectiveApprovalDate(o)).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) : '',\n              getHoursAgo(getEffectiveApprovalDate(o)),\n              'No',\n            ];\n          })\n        )\n      );\n    } else {\n      headers = ['Order Number', 'Date', 'Customer', 'Email', 'Product', 'SKU', 'Qty', 'Prescription Status', 'Total'];\n      rows = csvOrders.flatMap(o =>\n        (o.line_items?.length > 0 ? o.line_items : [{ title: '', sku: '', quantity: 0 }]).flatMap(item =>\n          Array.from({ length: Math.max(item.quantity || 1, 1) }, () => [\n            o.name,\n            new Date(o.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' }),\n            `${o.customer?.first_name || ''} ${o.customer?.last_name || ''}`.trim(),\n            o.customer?.email || '',\n            item.title || '',\n            item.sku || '',\n            1,\n            o.prescription_status || '',\n            `${o.currency} ${parseFloat(o.total_price || 0).toLocaleString()}`,\n          ])\n        )\n      );\n    }\n\n    const csv = [headers, ...rows].map(r => r.map(c => `\"${(c || '').toString().replace(/\"/g, '\"\"')}\"`).join(',')).join('\\n');\n    const blob = new Blob([csv], { type: 'text/csv' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement('a');\n    a.href = url;\n    a.download = `fulfillment-${activeTab}-${new Date().toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' }).replace(/\\//g, '-')}.csv`;\n    a.click();\n  };\n\n  const getHoursAgo = (dateStr) => {\n    if (!dateStr) return '—';\n    const hrs = (new Date() - new Date(dateStr)) / (1000 * 60 * 60);\n    if (hrs < 1) return '<1h';\n    if (hrs < 24) return `${Math.floor(hrs)}h`;\n    const days = Math.floor(hrs / 24);\n    const remHrs = Math.floor(hrs % 24);\n    return `${days}d ${remHrs}h`;\n  };\n\n  // New tile structure logic\n  // Check if order was auto-approved (within 5 min of creation) AND has scheduled consultation\n  const isAwaitingConsultation = (o) => {\n    if (!o.consultation_status || o.consultation_status.toLowerCase() !== 'scheduled') return false;\n    // Only hold if approved within 5 minutes of order creation (auto-approval)\n    // If manually approved (>5 min), someone already reviewed it — ship normally\n    if (!o.approved_at || !o.created_at) return true; // no approval time = treat as auto\n    const created = new Date(o.created_at).getTime();\n    const approved = new Date(o.approved_at).getTime();\n    const diffMinutes = (approved - created) / (1000 * 60);\n    return diffMinutes <= 5;\n  };\n\n  const getTileCounts = () => {\n    const now = new Date();\n    const phtNow = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n    const phtDay = phtNow.getDay(); // 0=Sun\n\n    if (phtDay === 0) return { shipToday: 0, overdue: 0, scheduled: 0, newOrders: 0, awaitingConsult: 0, pending: 0 };\n\n    // Today's date for comparison (YYYY-MM-DD in PHT)\n    const todayPHT = new Date(phtNow.getFullYear(), phtNow.getMonth(), phtNow.getDate());\n\n    // \"Previous business day\" cutoffs in PHT\n    // If today is Monday (1), previous business day is Saturday (not Sunday)\n    // If today is Sunday (0), we already returned zeros above\n    const prevBizDayOffset = phtDay === 1 ? 2 : 1; // Mon → go back 2 days (Sat), else go back 1 day\n\n    // Cutoff hours: 7:30 AM for all orders, 12 noon for sexual health (Erectile Dysfunction)\n    const defaultCutoffHour = 7.5; // 7:30 AM\n    const sexualHealthCutoffHour = 12; // 12 noon\n\n    // Helper: check if order contains sexual health products\n    const isSexualHealthOrder = (o) => (o.line_items || []).some(li =>\n      (li.product_type || '').toLowerCase().includes('erectile dysfunction')\n    );\n\n    // Helper: get cutoff times for a given hour (supports half hours)\n    const makeCutoff = (baseDate, hour) => {\n      const d = new Date(baseDate);\n      d.setHours(Math.floor(hour), (hour % 1) * 60, 0, 0);\n      return d;\n    };\n\n    const yesterdayDefault = makeCutoff(new Date(phtNow.getTime() - prevBizDayOffset * 86400000), defaultCutoffHour);\n    const yesterdaySexHealth = makeCutoff(new Date(phtNow.getTime() - prevBizDayOffset * 86400000), sexualHealthCutoffHour);\n    const todayDefault = makeCutoff(phtNow, defaultCutoffHour);\n    const todaySexHealth = makeCutoff(phtNow, sexualHealthCutoffHour);\n\n    let shipToday = 0; // Orders due TODAY only (not overdue)\n    let overdue = 0;   // Orders that should have shipped on a PREVIOUS day\n    let scheduled = 0;\n    let newOrders = 0;\n    let awaitingConsult = 0;\n\n    for (const o of approvedOrders) {\n      // Orders with \"Scheduled\" consultation status are held — don't ship yet\n      if (isAwaitingConsultation(o)) {\n        awaitingConsult++;\n        continue;\n      }\n      if (o.preferred_delivery_date) {\n        // Orders WITH delivery date\n        const deliveryDate = new Date(o.preferred_delivery_date + 'T00:00:00');\n        const deliveryDatePHT = new Date(deliveryDate.toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n        const deliveryDateOnly = new Date(deliveryDatePHT.getFullYear(), deliveryDatePHT.getMonth(), deliveryDatePHT.getDate());\n        \n        if (deliveryDateOnly < todayPHT) {\n          // Delivery date is past → overdue only (not Ship Today)\n          overdue++;\n        } else if (deliveryDateOnly.getTime() === todayPHT.getTime()) {\n          // Delivery date is today → Ship Today\n          shipToday++;\n        } else {\n          // Delivery date is future → scheduled\n          scheduled++;\n        }\n      } else {\n        // Orders WITHOUT delivery date: use cutoff logic\n        const ref = getEffectiveApprovalDate(o);\n        const approvedPHT = new Date(new Date(ref).toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n        const isSH = isSexualHealthOrder(o);\n        const yesterdayCutoff = isSH ? yesterdaySexHealth : yesterdayDefault;\n        const todayCutoff = isSH ? todaySexHealth : todayDefault;\n\n        if (approvedPHT < yesterdayCutoff) {\n          // Approved before previous business day's cutoff → overdue\n          overdue++;\n        } else if (approvedPHT < todayCutoff) {\n          // Approved between previous biz day's cutoff and today's cutoff → Ship Today\n          shipToday++;\n        } else {\n          // Approved after today's cutoff → new (due tomorrow)\n          newOrders++;\n        }\n      }\n    }\n\n    const pending = shipToday + overdue + scheduled + newOrders + awaitingConsult;\n    return { shipToday, overdue, scheduled, newOrders, awaitingConsult, pending };\n  };\n\n  // Helper function to get the effective approval date\n  // For orders that went through consultation: use consultation completion time\n  // For others: later of approved_at vs created_at\n  const getEffectiveApprovalDate = (order) => {\n    // If order was auto-approved (within 5 min) and had a consultation that's now complete,\n    // the real approval is when the consultation completed\n    const cs = order.consultation_status?.toLowerCase();\n    if (order.consultation_status_updated_at && cs && cs !== 'scheduled' && cs !== 'not required') {\n      // Only use consultation time if it was auto-approved (within 5 min)\n      const created = new Date(order.created_at).getTime();\n      const approved = order.approved_at ? new Date(order.approved_at).getTime() : created;\n      const diffMin = (approved - created) / (1000 * 60);\n      if (diffMin <= 5) {\n        return order.consultation_status_updated_at;\n      }\n    }\n    \n    const approvedAt = order.approved_at ? new Date(order.approved_at) : null;\n    const createdAt = new Date(order.created_at);\n    ","numLines":300,"startLine":40,"totalLines":938}}}
