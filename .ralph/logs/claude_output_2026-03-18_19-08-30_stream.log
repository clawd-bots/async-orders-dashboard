{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tu165G4DtHExPY3DSLea26","type":"tool_result","content":"     1→// Cron endpoint for daily fulfillment report\n     2→// Triggered by Vercel Cron at 8 AM PHT (00:00 UTC)\n     3→\n     4→export const config = {\n     5→  runtime: 'edge',\n     6→};\n     7→\n     8→export default async function handler(req) {\n     9→  // Verify cron secret in production\n    10→  const authHeader = req.headers.get('authorization');\n    11→  if (process.env.CRON_SECRET && authHeader !== `Bearer ${process.env.CRON_SECRET}`) {\n    12→    return new Response('Unauthorized', { status: 401 });\n    13→  }\n    14→\n    15→  const storeUrl = process.env.SHOPIFY_STORE_URL;\n    16→  const accessToken = process.env.SHOPIFY_ACCESS_TOKEN;\n    17→  const agentmailKey = process.env.AGENTMAIL_API_KEY;\n    18→\n    19→  if (!storeUrl || !accessToken || !agentmailKey) {\n    20→    return new Response(JSON.stringify({ error: 'Missing configuration' }), { \n    21→      status: 400,\n    22→      headers: { 'Content-Type': 'application/json' }\n    23→    });\n    24→  }\n    25→\n    26→  try {\n    27→    // Use GraphQL to fetch orders with metafields (same as orders.js)\n    28→    const graphqlUrl = `https://${storeUrl}/admin/api/2024-01/graphql.json`;\n    29→    \n    30→    // Fetch ALL orders using cursor-based pagination\n    31→    let allOrders = [];\n    32→    let hasNextPage = true;\n    33→    let cursor = null;\n    34→\n    35→    while (hasNextPage) {\n    36→      const query = `\n    37→        {\n    38→          orders(first: 250, sortKey: CREATED_AT, reverse: true, query: \"fulfillment_status:unfulfilled financial_status:paid\"${cursor ? `, after: \"${cursor}\"` : \"\"}) {\n    39→            pageInfo {\n    40→              hasNextPage\n    41→              endCursor\n    42→            }\n    43→            edges {\n    44→              node {\n    45→                id\n    46→                name\n    47→                createdAt\n    48→                totalPriceSet {\n    49→                  shopMoney {\n    50→                    amount\n    51→                    currencyCode\n    52→                  }\n    53→                }\n    54→                customer {\n    55→                  firstName\n    56→                  lastName\n    57→                  email\n    58→                }\n    59→                lineItems(first: 10) {\n    60→                  edges {\n    61→                    node {\n    62→                      title\n    63→                      quantity\n    64→                    }\n    65→                  }\n    66→                }\n    67→                metafield(namespace: \"custom\", key: \"approved_to_ship\") {\n    68→                  value\n    69→                }\n    70→                preferredDeliveryMetafield: metafield(namespace: \"custom\", key: \"preferred_delivery\") {\n    71→                  value\n    72→                }\n    73→                preferredDeliveryDateMetafield: metafield(namespace: \"custom\", key: \"preferred_delivery_date\") {\n    74→                  value\n    75→                }\n    76→                prescriptionStatusMetafield: metafield(namespace: \"custom\", key: \"prescription_status\") {\n    77→                  value\n    78→                }\n    79→                orderStatusMetafield: metafield(namespace: \"custom\", key: \"order_status\") {\n    80→                  value\n    81→                }\n    82→                discountCodes\n    83→              }\n    84→            }\n    85→          }\n    86→        }\n    87→      `;\n    88→\n    89→      const response = await fetch(graphqlUrl, {\n    90→        method: 'POST',\n    91→        headers: {\n    92→          'X-Shopify-Access-Token': accessToken,\n    93→          'Content-Type': 'application/json'\n    94→        },\n    95→        body: JSON.stringify({ query })\n    96→      });\n    97→\n    98→      if (!response.ok) {\n    99→        throw new Error(`Shopify API error: ${response.status}`);\n   100→      }\n   101→\n   102→      const data = await response.json();\n   103→      \n   104→      if (data.errors) {\n   105→        throw new Error(`GraphQL error: ${data.errors[0]?.message}`);\n   106→      }\n   107→\n   108→      const pageOrders = data.data?.orders?.edges || [];\n   109→      allOrders = allOrders.concat(pageOrders);\n   110→      \n   111→      hasNextPage = data.data?.orders?.pageInfo?.hasNextPage || false;\n   112→      cursor = data.data?.orders?.pageInfo?.endCursor || null;\n   113→    }\n   114→\n   115→    // Filter out Keevtest discount codes and process orders\n   116→    const filteredOrders = allOrders\n   117→      .filter(edge => {\n   118→        // Exclude orders with Keevtest discount code\n   119→        const discountCodes = edge.node.discountCodes || [];\n   120→        const hasKeevtest = discountCodes.some(code => \n   121→          code?.toLowerCase?.().includes('keevtest')\n   122→        );\n   123→        if (hasKeevtest) return false;\n   124→        \n   125→        // Exclude orders with Order Status = \"Manually Refunded\"\n   126→        const orderStatus = edge.node.orderStatusMetafield?.value?.toLowerCase?.() || '';\n   127→        if (orderStatus.includes('manually refunded')) return false;\n   128→        \n   129→        return true;\n   130→      })\n   131→      .map(edge => {\n   132→        const node = edge.node;\n   133→        const metafield = node.metafield;\n   134→        const val = metafield?.value?.toLowerCase?.() || '';\n   135→        \n   136→        // Three states: true (approved), false (explicitly not approved), null (empty/not set)\n   137→        let approvedToShip = null;\n   138→        if (val === 'true' || val === '1' || val === 'yes') {\n   139→          approvedToShip = true;\n   140→        } else if (val === 'false' || val === '0' || val === 'no') {\n   141→          approvedToShip = false;\n   142→        }\n   143→        \n   144→        // Parse preferred delivery metafield (True/False/Blank)\n   145→        const preferredDeliveryVal = node.preferredDeliveryMetafield?.value?.toLowerCase?.() || '';\n   146→        let preferredDelivery = null;\n   147→        if (preferredDeliveryVal === 'true' || preferredDeliveryVal === '1' || preferredDeliveryVal === 'yes') {\n   148→          preferredDelivery = true;\n   149→        } else if (preferredDeliveryVal === 'false' || preferredDeliveryVal === '0' || preferredDeliveryVal === 'no') {\n   150→          preferredDelivery = false;\n   151→        }\n   152→        \n   153→        return {\n   154→          id: node.id,\n   155→          name: node.name,\n   156→          created_at: node.createdAt,\n   157→          total_price: node.totalPriceSet?.shopMoney?.amount,\n   158→          currency: node.totalPriceSet?.shopMoney?.currencyCode,\n   159→          approved_to_ship: approvedToShip,\n   160→          preferred_delivery: preferredDelivery,\n   161→          preferred_delivery_date: node.preferredDeliveryDateMetafield?.value || null,\n   162→          prescription_status: node.prescriptionStatusMetafield?.value || null,\n   163→          customer: {\n   164→            first_name: node.customer?.firstName,\n   165→            last_name: node.customer?.lastName,\n   166→            email: node.customer?.email\n   167→          },\n   168→          line_items: node.lineItems?.edges?.map(e => ({\n   169→            title: e.node.title,\n   170→            quantity: e.node.quantity\n   171→          })) || []\n   172→        };\n   173→      });\n   174→\n   175→    // Separate approved and not approved orders\n   176→    const approvedOrders = filteredOrders.filter(o => o.approved_to_ship === true);\n   177→    const notApprovedOrders = filteredOrders.filter(o => o.approved_to_ship === false);\n   178→    \n   179→    // Sort by date (newest first)\n   180→    approvedOrders.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\n   181→    notApprovedOrders.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\n   182→\n   183→    // Calculate summary for approved orders\n   184→    const approvedTotalValue = approvedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n   185→    const approvedTotalItems = approvedOrders.reduce((sum, o) => \n   186→      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n   187→    \n   188→    // Calculate summary for not approved orders\n   189→    const notApprovedTotalValue = notApprovedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n   190→    const notApprovedTotalItems = notApprovedOrders.reduce((sum, o) => \n   191→      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n   192→\n   193→    const currency = (approvedOrders[0] || notApprovedOrders[0])?.currency || 'PHP';\n   194→\n   195→    // Build email with PHT timezone\n   196→    const today = new Date().toLocaleDateString('en-PH', { \n   197→      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',\n   198→      timeZone: 'Asia/Manila'\n   199→    });\n   200→\n   201→    let emailBody = `Daily Fulfillment Report - ${today}\\n`;\n   202→    emailBody += `${'='.repeat(50)}\\n\\n`;\n   203→    \n   204→    emailBody += `SUMMARY\\n`;\n   205→    emailBody += `-`.repeat(30) + `\\n`;\n   206→    emailBody += `Approved Orders: ${approvedOrders.length} (${currency} ${approvedTotalValue.toLocaleString()}, ${approvedTotalItems} items)\\n`;\n   207→    emailBody += `Not Approved Orders: ${notApprovedOrders.length} (${currency} ${notApprovedTotalValue.toLocaleString()}, ${notApprovedTotalItems} items)\\n`;\n   208→    emailBody += `Total Pending: ${approvedOrders.length + notApprovedOrders.length} orders\\n\\n`;\n   209→\n   210→    if (approvedOrders.length === 0 && notApprovedOrders.length === 0) {\n   211→      emailBody += `✅ All orders have been fulfilled! Great job!\\n`;\n   212→    } else {\n   213→      // APPROVED ORDERS SECTION\n   214→      if (approvedOrders.length > 0) {\n   215→        emailBody += `✅ APPROVED ORDERS (${approvedOrders.length})\\n`;\n   216→        emailBody += `-`.repeat(30) + `\\n\\n`;\n   217→\n   218→        approvedOrders.forEach((order, i) => {\n   219→          const customerName = [order.customer?.first_name, order.customer?.last_name].filter(Boolean).join(' ') || 'Guest';\n   220→          const orderDate = new Date(order.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' });\n   221→          const daysAgo = Math.floor((new Date() - new Date(order.created_at)) / (1000 * 60 * 60 * 24));\n   222→          \n   223→          emailBody += `${i + 1}. ${order.name} - ${customerName}\\n`;\n   224→          emailBody += `   Date: ${orderDate} (${daysAgo === 0 ? 'Today' : daysAgo === 1 ? 'Yesterday' : daysAgo + ' days ago'})\\n`;\n   225→          emailBody += `   Total: ${order.currency} ${parseFloat(order.total_price).toLocaleString()}\\n`;\n   226→          \n   227→          // Add new metafields for approved orders\n   228→          if (order.preferred_delivery !== null) {\n   229→            emailBody += `   Preferred Delivery: ${order.preferred_delivery ? 'Yes' : 'No'}\\n`;\n   230→          }\n   231→          if (order.preferred_delivery_date) {\n   232→            const deliveryDate = new Date(order.preferred_delivery_date).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' });\n   233→            emailBody += `   Delivery Date: ${deliveryDate}\\n`;\n   234→          }\n   235→          \n   236→          emailBody += `   Items:\\n`;\n   237→          order.line_items?.forEach(item => {\n   238→            emailBody += `     - ${item.quantity}× ${item.title}\\n`;\n   239→          });\n   240→          \n   241→          emailBody += `\\n`;\n   242→        });\n   243→\n   244→        // Orders older than 3 days warning for approved\n   245→        const oldApprovedOrders = approvedOrders.filter(o => {\n   246→          const days = Math.floor((new Date() - new Date(o.created_at)) / (1000 * 60 * 60 * 24));\n   247→          return days >= 3;\n   248→        });\n   249→\n   250→        if (oldApprovedOrders.length > 0) {\n   251→          emailBody += `⚠️ ATTENTION: ${oldApprovedOrders.length} approved order(s) are 3+ days old and need urgent attention!\\n\\n`;\n   252→        }\n   253→      }\n   254→\n   255→      // NOT APPROVED ORDERS SECTION\n   256→      if (notApprovedOrders.length > 0) {\n   257→        emailBody += `⏳ NOT APPROVED ORDERS (${notApprovedOrders.length})\\n`;\n   258→        emailBody += `-`.repeat(30) + `\\n\\n`;\n   259→\n   260→        notApprovedOrders.forEach((order, i) => {\n   261→          const customerName = [order.customer?.first_name, order.customer?.last_name].filter(Boolean).join(' ') || 'Guest';\n   262→          const orderDate = new Date(order.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' });\n   263→          const daysAgo = Math.floor((new Date() - new Date(order.created_at)) / (1000 * 60 * 60 * 24));\n   264→          \n   265→          emailBody += `${i + 1}. ${order.name} - ${customerName}\\n`;\n   266→          emailBody += `   Date: ${orderDate} (${daysAgo === 0 ? 'Today' : daysAgo === 1 ? 'Yesterday' : daysAgo + ' days ago'})\\n`;\n   267→          emailBody += `   Total: ${order.currency} ${parseFloat(order.total_price).toLocaleString()}\\n`;\n   268→          \n   269→          // Add prescription status for not approved orders\n   270→          if (order.prescription_status) {\n   271→            emailBody += `   Prescription Status: ${order.prescription_status}\\n`;\n   272→          }\n   273→          \n   274→          emailBody += `   Items:\\n`;\n   275→          order.line_items?.forEach(item => {\n   276→            emailBody += `     - ${item.quantity}× ${item.title}\\n`;\n   277→          });\n   278→          \n   279→          emailBody += `\\n`;\n   280→        });\n   281→      }\n   282→    }\n   283→\n   284→    emailBody += `\\n---\\nGenerated automatically at 8:00 AM PHT\\nView dashboard: https://shopify-async-orders.vercel.app\\n`;\n   285→\n   286→    // Send via AgentMail with CC recipients\n   287→    const totalPendingOrders = approvedOrders.length + notApprovedOrders.length;\n   288→    const emailRes = await fetch('https://api.agentmail.io/v0/email', {\n   289→      method: 'POST',\n   290→      headers: {\n   291→        'Authorization': `Bearer ${agentmailKey}`,\n   292→        'Content-Type': 'application/json'\n   293→      },\n   294→      body: JSON.stringify({\n   295→        from: 'edwin@mail.andyou.ph',\n   296→        to: 'wesley@andyou.ph',\n   297→        cc: ['andrea@andyou.ph', 'bryan_bumanglag@andyou.ph'],\n   298→        subject: `📦 Daily Fulfillment Report: ${approvedOrders.length} approved, ${notApprovedOrders.length} not approved - ${today}`,\n   299→        text: emailBody\n   300→      })\n   301→    });\n   302→\n   303→    if (!emailRes.ok) {\n   304→      const err = await emailRes.text();\n   305→      throw new Error(`Email send failed: ${err}`);\n   306→    }\n   307→\n   308→    return new Response(JSON.stringify({ \n   309→      success: true, \n   310→      approvedOrderCount: approvedOrders.length,\n   311→      notApprovedOrderCount: notApprovedOrders.length,\n   312→      totalOrderCount: totalPendingOrders,\n   313→      sentAt: new Date().toISOString()\n   314→    }), {\n   315→      status: 200,\n   316→      headers: { 'Content-Type': 'application/json' }\n   317→    });\n   318→\n   319→  } catch (error) {\n   320→    console.error('Cron error:', error);\n   321→    return new Response(JSON.stringify({ error: error.message }), {\n   322→      status: 500,\n   323→      headers: { 'Content-Type': 'application/json' }\n   324→    });\n   325→  }\n   326→}\n   327→"}]},"parent_tool_use_id":null,"session_id":"652984ef-afb7-4f4d-8ebb-d98b5eef4f87","uuid":"599d3532-9443-4472-9782-fd7968a5ec7a","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/async-orders-dashboard/api/cron.js","content":"// Cron endpoint for daily fulfillment report\n// Triggered by Vercel Cron at 8 AM PHT (00:00 UTC)\n\nexport const config = {\n  runtime: 'edge',\n};\n\nexport default async function handler(req) {\n  // Verify cron secret in production\n  const authHeader = req.headers.get('authorization');\n  if (process.env.CRON_SECRET && authHeader !== `Bearer ${process.env.CRON_SECRET}`) {\n    return new Response('Unauthorized', { status: 401 });\n  }\n\n  const storeUrl = process.env.SHOPIFY_STORE_URL;\n  const accessToken = process.env.SHOPIFY_ACCESS_TOKEN;\n  const agentmailKey = process.env.AGENTMAIL_API_KEY;\n\n  if (!storeUrl || !accessToken || !agentmailKey) {\n    return new Response(JSON.stringify({ error: 'Missing configuration' }), { \n      status: 400,\n      headers: { 'Content-Type': 'application/json' }\n    });\n  }\n\n  try {\n    // Use GraphQL to fetch orders with metafields (same as orders.js)\n    const graphqlUrl = `https://${storeUrl}/admin/api/2024-01/graphql.json`;\n    \n    // Fetch ALL orders using cursor-based pagination\n    let allOrders = [];\n    let hasNextPage = true;\n    let cursor = null;\n\n    while (hasNextPage) {\n      const query = `\n        {\n          orders(first: 250, sortKey: CREATED_AT, reverse: true, query: \"fulfillment_status:unfulfilled financial_status:paid\"${cursor ? `, after: \"${cursor}\"` : \"\"}) {\n            pageInfo {\n              hasNextPage\n              endCursor\n            }\n            edges {\n              node {\n                id\n                name\n                createdAt\n                totalPriceSet {\n                  shopMoney {\n                    amount\n                    currencyCode\n                  }\n                }\n                customer {\n                  firstName\n                  lastName\n                  email\n                }\n                lineItems(first: 10) {\n                  edges {\n                    node {\n                      title\n                      quantity\n                    }\n                  }\n                }\n                metafield(namespace: \"custom\", key: \"approved_to_ship\") {\n                  value\n                }\n                preferredDeliveryMetafield: metafield(namespace: \"custom\", key: \"preferred_delivery\") {\n                  value\n                }\n                preferredDeliveryDateMetafield: metafield(namespace: \"custom\", key: \"preferred_delivery_date\") {\n                  value\n                }\n                prescriptionStatusMetafield: metafield(namespace: \"custom\", key: \"prescription_status\") {\n                  value\n                }\n                orderStatusMetafield: metafield(namespace: \"custom\", key: \"order_status\") {\n                  value\n                }\n                discountCodes\n              }\n            }\n          }\n        }\n      `;\n\n      const response = await fetch(graphqlUrl, {\n        method: 'POST',\n        headers: {\n          'X-Shopify-Access-Token': accessToken,\n          'Content-Type': 'application/json'\n        },\n        body: JSON.stringify({ query })\n      });\n\n      if (!response.ok) {\n        throw new Error(`Shopify API error: ${response.status}`);\n      }\n\n      const data = await response.json();\n      \n      if (data.errors) {\n        throw new Error(`GraphQL error: ${data.errors[0]?.message}`);\n      }\n\n      const pageOrders = data.data?.orders?.edges || [];\n      allOrders = allOrders.concat(pageOrders);\n      \n      hasNextPage = data.data?.orders?.pageInfo?.hasNextPage || false;\n      cursor = data.data?.orders?.pageInfo?.endCursor || null;\n    }\n\n    // Filter out Keevtest discount codes and process orders\n    const filteredOrders = allOrders\n      .filter(edge => {\n        // Exclude orders with Keevtest discount code\n        const discountCodes = edge.node.discountCodes || [];\n        const hasKeevtest = discountCodes.some(code => \n          code?.toLowerCase?.().includes('keevtest')\n        );\n        if (hasKeevtest) return false;\n        \n        // Exclude orders with Order Status = \"Manually Refunded\"\n        const orderStatus = edge.node.orderStatusMetafield?.value?.toLowerCase?.() || '';\n        if (orderStatus.includes('manually refunded')) return false;\n        \n        return true;\n      })\n      .map(edge => {\n        const node = edge.node;\n        const metafield = node.metafield;\n        const val = metafield?.value?.toLowerCase?.() || '';\n        \n        // Three states: true (approved), false (explicitly not approved), null (empty/not set)\n        let approvedToShip = null;\n        if (val === 'true' || val === '1' || val === 'yes') {\n          approvedToShip = true;\n        } else if (val === 'false' || val === '0' || val === 'no') {\n          approvedToShip = false;\n        }\n        \n        // Parse preferred delivery metafield (True/False/Blank)\n        const preferredDeliveryVal = node.preferredDeliveryMetafield?.value?.toLowerCase?.() || '';\n        let preferredDelivery = null;\n        if (preferredDeliveryVal === 'true' || preferredDeliveryVal === '1' || preferredDeliveryVal === 'yes') {\n          preferredDelivery = true;\n        } else if (preferredDeliveryVal === 'false' || preferredDeliveryVal === '0' || preferredDeliveryVal === 'no') {\n          preferredDelivery = false;\n        }\n        \n        return {\n          id: node.id,\n          name: node.name,\n          created_at: node.createdAt,\n          total_price: node.totalPriceSet?.shopMoney?.amount,\n          currency: node.totalPriceSet?.shopMoney?.currencyCode,\n          approved_to_ship: approvedToShip,\n          preferred_delivery: preferredDelivery,\n          preferred_delivery_date: node.preferredDeliveryDateMetafield?.value || null,\n          prescription_status: node.prescriptionStatusMetafield?.value || null,\n          customer: {\n            first_name: node.customer?.firstName,\n            last_name: node.customer?.lastName,\n            email: node.customer?.email\n          },\n          line_items: node.lineItems?.edges?.map(e => ({\n            title: e.node.title,\n            quantity: e.node.quantity\n          })) || []\n        };\n      });\n\n    // Separate approved and not approved orders\n    const approvedOrders = filteredOrders.filter(o => o.approved_to_ship === true);\n    const notApprovedOrders = filteredOrders.filter(o => o.approved_to_ship === false);\n    \n    // Sort by date (newest first)\n    approvedOrders.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\n    notApprovedOrders.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\n\n    // Calculate summary for approved orders\n    const approvedTotalValue = approvedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n    const approvedTotalItems = approvedOrders.reduce((sum, o) => \n      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n    \n    // Calculate summary for not approved orders\n    const notApprovedTotalValue = notApprovedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n    const notApprovedTotalItems = notApprovedOrders.reduce((sum, o) => \n      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n\n    const currency = (approvedOrders[0] || notApprovedOrders[0])?.currency || 'PHP';\n\n    // Build email with PHT timezone\n    const today = new Date().toLocaleDateString('en-PH', { \n      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',\n      timeZone: 'Asia/Manila'\n    });\n\n    let emailBody = `Daily Fulfillment Report - ${today}\\n`;\n    emailBody += `${'='.repeat(50)}\\n\\n`;\n    \n    emailBody += `SUMMARY\\n`;\n    emailBody += `-`.repeat(30) + `\\n`;\n    emailBody += `Approved Orders: ${approvedOrders.length} (${currency} ${approvedTotalValue.toLocaleString()}, ${approvedTotalItems} items)\\n`;\n    emailBody += `Not Approved Orders: ${notApprovedOrders.length} (${currency} ${notApprovedTotalValue.toLocaleString()}, ${notApprovedTotalItems} items)\\n`;\n    emailBody += `Total Pending: ${approvedOrders.length + notApprovedOrders.length} orders\\n\\n`;\n\n    if (approvedOrders.length === 0 && notApprovedOrders.length === 0) {\n      emailBody += `✅ All orders have been fulfilled! Great job!\\n`;\n    } else {\n      // APPROVED ORDERS SECTION\n      if (approvedOrders.length > 0) {\n        emailBody += `✅ APPROVED ORDERS (${approvedOrders.length})\\n`;\n        emailBody += `-`.repeat(30) + `\\n\\n`;\n\n        approvedOrders.forEach((order, i) => {\n          const customerName = [order.customer?.first_name, order.customer?.last_name].filter(Boolean).join(' ') || 'Guest';\n          const orderDate = new Date(order.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' });\n          const daysAgo = Math.floor((new Date() - new Date(order.created_at)) / (1000 * 60 * 60 * 24));\n          \n          emailBody += `${i + 1}. ${order.name} - ${customerName}\\n`;\n          emailBody += `   Date: ${orderDate} (${daysAgo === 0 ? 'Today' : daysAgo === 1 ? 'Yesterday' : daysAgo + ' days ago'})\\n`;\n          emailBody += `   Total: ${order.currency} ${parseFloat(order.total_price).toLocaleString()}\\n`;\n          \n          // Add new metafields for approved orders\n          if (order.preferred_delivery !== null) {\n            emailBody += `   Preferred Delivery: ${order.preferred_delivery ? 'Yes' : 'No'}\\n`;\n          }\n          if (order.preferred_delivery_date) {\n            const deliveryDate = new Date(order.preferred_delivery_date).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' });\n            emailBody += `   Delivery Date: ${deliveryDate}\\n`;\n          }\n          \n          emailBody += `   Items:\\n`;\n          order.line_items?.forEach(item => {\n            emailBody += `     - ${item.quantity}× ${item.title}\\n`;\n          });\n          \n          emailBody += `\\n`;\n        });\n\n        // Orders older than 3 days warning for approved\n        const oldApprovedOrders = approvedOrders.filter(o => {\n          const days = Math.floor((new Date() - new Date(o.created_at)) / (1000 * 60 * 60 * 24));\n          return days >= 3;\n        });\n\n        if (oldApprovedOrders.length > 0) {\n          emailBody += `⚠️ ATTENTION: ${oldApprovedOrders.length} approved order(s) are 3+ days old and need urgent attention!\\n\\n`;\n        }\n      }\n\n      // NOT APPROVED ORDERS SECTION\n      if (notApprovedOrders.length > 0) {\n        emailBody += `⏳ NOT APPROVED ORDERS (${notApprovedOrders.length})\\n`;\n        emailBody += `-`.repeat(30) + `\\n\\n`;\n\n        notApprovedOrders.forEach((order, i) => {\n          const customerName = [order.customer?.first_name, order.customer?.last_name].filter(Boolean).join(' ') || 'Guest';\n          const orderDate = new Date(order.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' });\n          const daysAgo = Math.floor((new Date() - new Date(order.created_at)) / (1000 * 60 * 60 * 24));\n          \n          emailBody += `${i + 1}. ${order.name} - ${customerName}\\n`;\n          emailBody += `   Date: ${orderDate} (${daysAgo === 0 ? 'Today' : daysAgo === 1 ? 'Yesterday' : daysAgo + ' days ago'})\\n`;\n          emailBody += `   Total: ${order.currency} ${parseFloat(order.total_price).toLocaleString()}\\n`;\n          \n          // Add prescription status for not approved orders\n          if (order.prescription_status) {\n            emailBody += `   Prescription Status: ${order.prescription_status}\\n`;\n          }\n          \n          emailBody += `   Items:\\n`;\n          order.line_items?.forEach(item => {\n            emailBody += `     - ${item.quantity}× ${item.title}\\n`;\n          });\n          \n          emailBody += `\\n`;\n        });\n      }\n    }\n\n    emailBody += `\\n---\\nGenerated automatically at 8:00 AM PHT\\nView dashboard: https://shopify-async-orders.vercel.app\\n`;\n\n    // Send via AgentMail with CC recipients\n    const totalPendingOrders = approvedOrders.length + notApprovedOrders.length;\n    const emailRes = await fetch('https://api.agentmail.io/v0/email', {\n      method: 'POST',\n      headers: {\n        'Authorization': `Bearer ${agentmailKey}`,\n        'Content-Type': 'application/json'\n      },\n      body: JSON.stringify({\n        from: 'edwin@mail.andyou.ph',\n        to: 'wesley@andyou.ph',\n        cc: ['andrea@andyou.ph', 'bryan_bumanglag@andyou.ph'],\n        subject: `📦 Daily Fulfillment Report: ${approvedOrders.length} approved, ${notApprovedOrders.length} not approved - ${today}`,\n        text: emailBody\n      })\n    });\n\n    if (!emailRes.ok) {\n      const err = await emailRes.text();\n      throw new Error(`Email send failed: ${err}`);\n    }\n\n    return new Response(JSON.stringify({ \n      success: true, \n      approvedOrderCount: approvedOrders.length,\n      notApprovedOrderCount: notApprovedOrders.length,\n      totalOrderCount: totalPendingOrders,\n      sentAt: new Date().toISOString()\n    }), {\n      status: 200,\n      headers: { 'Content-Type': 'application/json' }\n    });\n\n  } catch (error) {\n    console.error('Cron error:', error);\n    return new Response(JSON.stringify({ error: error.message }), {\n      status: 500,\n      headers: { 'Content-Type': 'application/json' }\n    });\n  }\n}\n","numLines":327,"startLine":1,"totalLines":327}}}
