{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B3qvBnxBo7NQ6e7cvfRWJo","type":"tool_result","content":"     1→// Cron endpoint for daily fulfillment report\n     2→// Triggered by Vercel Cron at 8 AM PHT (00:00 UTC)\n     3→\n     4→export const config = {\n     5→  runtime: 'edge',\n     6→};\n     7→\n     8→export default async function handler(req) {\n     9→  // Verify cron secret in production\n    10→  const authHeader = req.headers.get('authorization');\n    11→  if (process.env.CRON_SECRET && authHeader !== `Bearer ${process.env.CRON_SECRET}`) {\n    12→    return new Response('Unauthorized', { status: 401 });\n    13→  }\n    14→\n    15→  const storeUrl = process.env.SHOPIFY_STORE_URL;\n    16→  const accessToken = process.env.SHOPIFY_ACCESS_TOKEN;\n    17→  const agentmailKey = process.env.AGENTMAIL_API_KEY;\n    18→\n    19→  if (!storeUrl || !accessToken || !agentmailKey) {\n    20→    return new Response(JSON.stringify({ error: 'Missing configuration' }), { \n    21→      status: 400,\n    22→      headers: { 'Content-Type': 'application/json' }\n    23→    });\n    24→  }\n    25→\n    26→  try {\n    27→    // Use GraphQL to fetch orders with metafields (same as orders.js)\n    28→    const graphqlUrl = `https://${storeUrl}/admin/api/2024-01/graphql.json`;\n    29→    \n    30→    // Fetch ALL orders using cursor-based pagination\n    31→    let allOrders = [];\n    32→    let hasNextPage = true;\n    33→    let cursor = null;\n    34→\n    35→    while (hasNextPage) {\n    36→      const query = `\n    37→        {\n    38→          orders(first: 250, sortKey: CREATED_AT, reverse: true, query: \"fulfillment_status:unfulfilled financial_status:paid\"${cursor ? `, after: \"${cursor}\"` : \"\"}) {\n    39→            pageInfo {\n    40→              hasNextPage\n    41→              endCursor\n    42→            }\n    43→            edges {\n    44→              node {\n    45→                id\n    46→                name\n    47→                createdAt\n    48→                totalPriceSet {\n    49→                  shopMoney {\n    50→                    amount\n    51→                    currencyCode\n    52→                  }\n    53→                }\n    54→                customer {\n    55→                  firstName\n    56→                  lastName\n    57→                  email\n    58→                }\n    59→                lineItems(first: 10) {\n    60→                  edges {\n    61→                    node {\n    62→                      title\n    63→                      quantity\n    64→                    }\n    65→                  }\n    66→                }\n    67→                metafield(namespace: \"custom\", key: \"approved_to_ship\") {\n    68→                  value\n    69→                  updatedAt\n    70→                }\n    71→                preferredDeliveryMetafield: metafield(namespace: \"custom\", key: \"preferred_delivery\") {\n    72→                  value\n    73→                }\n    74→                preferredDeliveryDateMetafield: metafield(namespace: \"custom\", key: \"preferred_delivery_date\") {\n    75→                  value\n    76→                }\n    77→                prescriptionStatusMetafield: metafield(namespace: \"custom\", key: \"prescription_status\") {\n    78→                  value\n    79→                }\n    80→                orderStatusMetafield: metafield(namespace: \"custom\", key: \"order_status\") {\n    81→                  value\n    82→                }\n    83→                upsellMetafield: metafield(namespace: \"custom\", key: \"upsell\") {\n    84→                  value\n    85→                }\n    86→                upsellPaidMetafield: metafield(namespace: \"custom\", key: \"upsell_paid\") {\n    87→                  value\n    88→                  updatedAt\n    89→                }\n    90→                discountCodes\n    91→              }\n    92→            }\n    93→          }\n    94→        }\n    95→      `;\n    96→\n    97→      const response = await fetch(graphqlUrl, {\n    98→        method: 'POST',\n    99→        headers: {\n   100→          'X-Shopify-Access-Token': accessToken,\n   101→          'Content-Type': 'application/json'\n   102→        },\n   103→        body: JSON.stringify({ query })\n   104→      });\n   105→\n   106→      if (!response.ok) {\n   107→        throw new Error(`Shopify API error: ${response.status}`);\n   108→      }\n   109→\n   110→      const data = await response.json();\n   111→      \n   112→      if (data.errors) {\n   113→        throw new Error(`GraphQL error: ${data.errors[0]?.message}`);\n   114→      }\n   115→\n   116→      const pageOrders = data.data?.orders?.edges || [];\n   117→      allOrders = allOrders.concat(pageOrders);\n   118→      \n   119→      hasNextPage = data.data?.orders?.pageInfo?.hasNextPage || false;\n   120→      cursor = data.data?.orders?.pageInfo?.endCursor || null;\n   121→    }\n   122→\n   123→    // Filter out Keevtest discount codes and process orders\n   124→    const filteredOrders = allOrders\n   125→      .filter(edge => {\n   126→        // Exclude orders with Keevtest discount code\n   127→        const discountCodes = edge.node.discountCodes || [];\n   128→        const hasKeevtest = discountCodes.some(code => \n   129→          code?.toLowerCase?.().includes('keevtest')\n   130→        );\n   131→        if (hasKeevtest) return false;\n   132→        \n   133→        // Exclude orders with Order Status = \"Manually Refunded\"\n   134→        const orderStatus = edge.node.orderStatusMetafield?.value?.toLowerCase?.() || '';\n   135→        if (orderStatus.includes('manually refunded')) return false;\n   136→        \n   137→        return true;\n   138→      })\n   139→      .map(edge => {\n   140→        const node = edge.node;\n   141→        const metafield = node.metafield;\n   142→        const val = metafield?.value?.toLowerCase?.() || '';\n   143→        \n   144→        // Three states: true (approved), false (explicitly not approved), null (empty/not set)\n   145→        let approvedToShip = null;\n   146→        if (val === 'true' || val === '1' || val === 'yes') {\n   147→          approvedToShip = true;\n   148→        } else if (val === 'false' || val === '0' || val === 'no') {\n   149→          approvedToShip = false;\n   150→        }\n   151→        \n   152→        // Parse preferred delivery metafield (True/False/Blank)\n   153→        const preferredDeliveryVal = node.preferredDeliveryMetafield?.value?.toLowerCase?.() || '';\n   154→        let preferredDelivery = null;\n   155→        if (preferredDeliveryVal === 'true' || preferredDeliveryVal === '1' || preferredDeliveryVal === 'yes') {\n   156→          preferredDelivery = true;\n   157→        } else if (preferredDeliveryVal === 'false' || preferredDeliveryVal === '0' || preferredDeliveryVal === 'no') {\n   158→          preferredDelivery = false;\n   159→        }\n   160→        \n   161→        return {\n   162→          id: node.id,\n   163→          name: node.name,\n   164→          created_at: node.createdAt,\n   165→          total_price: node.totalPriceSet?.shopMoney?.amount,\n   166→          currency: node.totalPriceSet?.shopMoney?.currencyCode,\n   167→          approved_to_ship: approvedToShip,\n   168→          approved_at: approvedToShip === true ? (metafield?.updatedAt || null) : null,\n   169→          preferred_delivery: preferredDelivery,\n   170→          preferred_delivery_date: node.preferredDeliveryDateMetafield?.value || null,\n   171→          prescription_status: node.prescriptionStatusMetafield?.value || null,\n   172→          customer: {\n   173→            first_name: node.customer?.firstName,\n   174→            last_name: node.customer?.lastName,\n   175→            email: node.customer?.email\n   176→          },\n   177→          line_items: node.lineItems?.edges?.map(e => ({\n   178→            title: e.node.title,\n   179→            quantity: e.node.quantity\n   180→          })) || [],\n   181→          upsell: (() => {\n   182→            const v = node.upsellMetafield?.value?.toLowerCase?.() || '';\n   183→            if (v === 'true' || v === '1' || v === 'yes') return true;\n   184→            if (v === 'false' || v === '0' || v === 'no') return false;\n   185→            return null;\n   186→          })(),\n   187→          upsell_paid: (() => {\n   188→            const v = node.upsellPaidMetafield?.value?.toLowerCase?.() || '';\n   189→            if (v === 'true' || v === '1' || v === 'yes') return true;\n   190→            if (v === 'false' || v === '0' || v === 'no') return false;\n   191→            return null;\n   192→          })(),\n   193→          upsell_paid_at: (() => {\n   194→            const v = node.upsellPaidMetafield?.value?.toLowerCase?.() || '';\n   195→            return (v === 'true' || v === '1' || v === 'yes') ? (node.upsellPaidMetafield?.updatedAt || null) : null;\n   196→          })(),\n   197→        };\n   198→      });\n   199→\n   200→    // Overdue helper\n   201→    const getNextCutoffAfter = (date) => {\n   202→      const d = new Date(date);\n   203→      const phtDate = new Date(d.getTime() + 8 * 3600000);\n   204→      const year = phtDate.getUTCFullYear();\n   205→      const month = phtDate.getUTCMonth();\n   206→      const day = phtDate.getUTCDate();\n   207→      const cutoff7am = new Date(Date.UTC(year, month, day, 7, 0, 0) - 8 * 3600000);\n   208→      const cutoff12pm = new Date(Date.UTC(year, month, day, 12, 0, 0) - 8 * 3600000);\n   209→      if (d < cutoff7am) return cutoff7am;\n   210→      if (d < cutoff12pm) return cutoff12pm;\n   211→      return new Date(Date.UTC(year, month, day + 1, 7, 0, 0) - 8 * 3600000);\n   212→    };\n   213→\n   214→    const isOrderOverdue = (order) => {\n   215→      let startTime;\n   216→      if (order.upsell === true) {\n   217→        if (!order.upsell_paid) return false;\n   218→        startTime = new Date(order.upsell_paid_at);\n   219→      } else {\n   220→        if (!order.approved_at) return false;\n   221→        startTime = new Date(order.approved_at);\n   222→      }\n   223→      return new Date() > getNextCutoffAfter(startTime);\n   224→    };\n   225→\n   226→    // Separate approved and not approved orders\n   227→    const approvedOrders = filteredOrders\n   228→      .filter(o => {\n   229→        if (o.approved_to_ship !== true) return false;\n   230→        if (o.upsell === true) return o.upsell_paid === true;\n   231→        return true;\n   232→      })\n   233→      .map(o => ({ ...o, overdue: isOrderOverdue(o) }));\n   234→    const awaitingUpsellOrders = filteredOrders\n   235→      .filter(o => o.approved_to_ship === true && o.upsell === true && o.upsell_paid !== true);\n   236→    const notApprovedOrders = filteredOrders.filter(o => o.approved_to_ship === false);\n   237→    \n   238→    // Sort by date (newest first)\n   239→    approvedOrders.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\n   240→    notApprovedOrders.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\n   241→\n   242→    // Calculate summary for approved orders\n   243→    const approvedTotalValue = approvedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n   244→    const approvedTotalItems = approvedOrders.reduce((sum, o) => \n   245→      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n   246→    \n   247→    // Calculate summary for not approved orders\n   248→    const notApprovedTotalValue = notApprovedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n   249→    const notApprovedTotalItems = notApprovedOrders.reduce((sum, o) =>\n   250→      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n   251→    const overdueOrders = approvedOrders.filter(o => o.overdue);\n   252→    const awaitingUpsellTotalValue = awaitingUpsellOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n   253→\n   254→    const currency = (approvedOrders[0] || notApprovedOrders[0])?.currency || 'PHP';\n   255→\n   256→    // Build email with PHT timezone\n   257→    const today = new Date().toLocaleDateString('en-PH', { \n   258→      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',\n   259→      timeZone: 'Asia/Manila'\n   260→    });\n   261→\n   262→    let emailBody = `Daily Fulfillment Report - ${today}\\n`;\n   263→    emailBody += `${'='.repeat(50)}\\n\\n`;\n   264→    \n   265→    emailBody += `SUMMARY\\n`;\n   266→    emailBody += `-`.repeat(30) + `\\n`;\n   267→    if (overdueOrders.length > 0) {\n   268→      emailBody += `🚨 OVERDUE: ${overdueOrders.length} orders\\n`;\n   269→    }\n   270→    emailBody += `Approved Orders: ${approvedOrders.length} (${currency} ${approvedTotalValue.toLocaleString()}, ${approvedTotalItems} items)\\n`;\n   271→    if (awaitingUpsellOrders.length > 0) {\n   272→      emailBody += `Awaiting Upsell Payment: ${awaitingUpsellOrders.length} (${currency} ${awaitingUpsellTotalValue.toLocaleString()})\\n`;\n   273→    }\n   274→    emailBody += `Not Approved Orders: ${notApprovedOrders.length} (${currency} ${notApprovedTotalValue.toLocaleString()}, ${notApprovedTotalItems} items)\\n`;\n   275→    emailBody += `Total Pending: ${approvedOrders.length + awaitingUpsellOrders.length + notApprovedOrders.length} orders\\n\\n`;\n   276→\n   277→    if (approvedOrders.length === 0 && awaitingUpsellOrders.length === 0 && notApprovedOrders.length === 0) {\n   278→      emailBody += `✅ All orders have been fulfilled! Great job!\\n`;\n   279→    } else {\n   280→      // OVERDUE ORDERS SECTION\n   281→      if (overdueOrders.length > 0) {\n   282→        emailBody += `🚨 OVERDUE ORDERS (${overdueOrders.length})\\n`;\n   283→        emailBody += `-`.repeat(30) + `\\n\\n`;\n   284→        overdueOrders.forEach((order, i) => {\n   285→          const customerName = [order.customer?.first_name, order.customer?.last_name].filter(Boolean).join(' ') || 'Guest';\n   286→          const orderDate = new Date(order.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' });\n   287→          emailBody += `${i + 1}. ${order.name} - ${customerName}\\n`;\n   288→          emailBody += `   Date: ${orderDate}\\n`;\n   289→          emailBody += `   Total: ${order.currency} ${parseFloat(order.total_price).toLocaleString()}\\n`;\n   290→          if (order.upsell === true) {\n   291→            emailBody += `   Upsell: Paid ✅ (${new Date(order.upsell_paid_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' })})\\n`;\n   292→          }\n   293→          emailBody += `   Items:\\n`;\n   294→          order.line_items?.forEach(item => {\n   295→            emailBody += `     - ${item.quantity}× ${item.title}\\n`;\n   296→          });\n   297→          emailBody += `\\n`;\n   298→        });\n   299→      }\n   300→\n   301→      // AWAITING UPSELL PAYMENT SECTION\n   302→      if (awaitingUpsellOrders.length > 0) {\n   303→        emailBody += `💰 AWAITING UPSELL PAYMENT (${awaitingUpsellOrders.length})\\n`;\n   304→        emailBody += `-`.repeat(30) + `\\n\\n`;\n   305→        awaitingUpsellOrders.forEach((order, i) => {\n   306→          const customerName = [order.customer?.first_name, order.customer?.last_name].filter(Boolean).join(' ') || 'Guest';\n   307→          const orderDate = new Date(order.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' });\n   308→          emailBody += `${i + 1}. ${order.name} - ${customerName}\\n`;\n   309→          emailBody += `   Date: ${orderDate}\\n`;\n   310→          emailBody += `   Total: ${order.currency} ${parseFloat(order.total_price).toLocaleString()}\\n`;\n   311→          emailBody += `   Upsell: Awaiting Payment ⏳\\n`;\n   312→          emailBody += `   Items:\\n`;\n   313→          order.line_items?.forEach(item => {\n   314→            emailBody += `     - ${item.quantity}× ${item.title}\\n`;\n   315→          });\n   316→          emailBody += `\\n`;\n   317→        });\n   318→      }\n   319→\n   320→      // APPROVED ORDERS SECTION\n   321→      if (approvedOrders.length > 0) {\n   322→        emailBody += `✅ APPROVED ORDERS (${approvedOrders.length})\\n`;\n   323→        emailBody += `-`.repeat(30) + `\\n\\n`;\n   324→\n   325→        approvedOrders.forEach((order, i) => {\n   326→          const customerName = [order.customer?.first_name, order.customer?.last_name].filter(Boolean).join(' ') || 'Guest';\n   327→          const orderDate = new Date(order.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' });\n   328→          const daysAgo = Math.floor((new Date() - new Date(order.created_at)) / (1000 * 60 * 60 * 24));\n   329→          \n   330→          emailBody += `${i + 1}. ${order.name} - ${customerName}\\n`;\n   331→          emailBody += `   Date: ${orderDate} (${daysAgo === 0 ? 'Today' : daysAgo === 1 ? 'Yesterday' : daysAgo + ' days ago'})\\n`;\n   332→          emailBody += `   Total: ${order.currency} ${parseFloat(order.total_price).toLocaleString()}\\n`;\n   333→          \n   334→          // Add new metafields for approved orders\n   335→          if (order.preferred_delivery !== null) {\n   336→            emailBody += `   Preferred Delivery: ${order.preferred_delivery ? 'Yes' : 'No'}\\n`;\n   337→          }\n   338→          if (order.preferred_delivery_date) {\n   339→            const deliveryDate = new Date(order.preferred_delivery_date).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' });\n   340→            emailBody += `   Delivery Date: ${deliveryDate}\\n`;\n   341→          }\n   342→          if (order.upsell === true) {\n   343→            emailBody += `   Upsell: Paid ✅\\n`;\n   344→          }\n   345→\n   346→          emailBody += `   Items:\\n`;\n   347→          order.line_items?.forEach(item => {\n   348→            emailBody += `     - ${item.quantity}× ${item.title}\\n`;\n   349→          });\n   350→          \n   351→          emailBody += `\\n`;\n   352→        });\n   353→\n   354→        // Orders older than 3 days warning for approved\n   355→        const oldApprovedOrders = approvedOrders.filter(o => {\n   356→          const days = Math.floor((new Date() - new Date(o.created_at)) / (1000 * 60 * 60 * 24));\n   357→          return days >= 3;\n   358→        });\n   359→\n   360→        if (oldApprovedOrders.length > 0) {\n   361→          emailBody += `⚠️ ATTENTION: ${oldApprovedOrders.length} approved order(s) are 3+ days old and need urgent attention!\\n\\n`;\n   362→        }\n   363→      }\n   364→\n   365→      // NOT APPROVED ORDERS SECTION\n   366→      if (notApprovedOrders.length > 0) {\n   367→        emailBody += `⏳ NOT APPROVED ORDERS (${notApprovedOrders.length})\\n`;\n   368→        emailBody += `-`.repeat(30) + `\\n\\n`;\n   369→\n   370→        notApprovedOrders.forEach((order, i) => {\n   371→          const customerName = [order.customer?.first_name, order.customer?.last_name].filter(Boolean).join(' ') || 'Guest';\n   372→          const orderDate = new Date(order.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' });\n   373→          const daysAgo = Math.floor((new Date() - new Date(order.created_at)) / (1000 * 60 * 60 * 24));\n   374→          \n   375→          emailBody += `${i + 1}. ${order.name} - ${customerName}\\n`;\n   376→          emailBody += `   Date: ${orderDate} (${daysAgo === 0 ? 'Today' : daysAgo === 1 ? 'Yesterday' : daysAgo + ' days ago'})\\n`;\n   377→          emailBody += `   Total: ${order.currency} ${parseFloat(order.total_price).toLocaleString()}\\n`;\n   378→          \n   379→          // Add prescription status for not approved orders\n   380→          if (order.prescription_status) {\n   381→            emailBody += `   Prescription Status: ${order.prescription_status}\\n`;\n   382→          }\n   383→          \n   384→          emailBody += `   Items:\\n`;\n   385→          order.line_items?.forEach(item => {\n   386→            emailBody += `     - ${item.quantity}× ${item.title}\\n`;\n   387→          });\n   388→          \n   389→          emailBody += `\\n`;\n   390→        });\n   391→      }\n   392→    }\n   393→\n   394→    emailBody += `\\n---\\nGenerated automatically at 8:00 AM PHT\\nView dashboard: https://shopify-async-orders.vercel.app\\n`;\n   395→\n   396→    // Send via AgentMail with CC recipients\n   397→    const totalPendingOrders = approvedOrders.length + awaitingUpsellOrders.length + notApprovedOrders.length;\n   398→    const emailRes = await fetch('https://api.agentmail.io/v0/email', {\n   399→      method: 'POST',\n   400→      headers: {\n   401→        'Authorization': `Bearer ${agentmailKey}`,\n   402→        'Content-Type': 'application/json'\n   403→      },\n   404→      body: JSON.stringify({\n   405→        from: 'edwin@mail.andyou.ph',\n   406→        to: 'wesley@andyou.ph',\n   407→        cc: ['andrea@andyou.ph', 'bryan_bumanglag@andyou.ph'],\n   408→        subject: overdueOrders.length > 0\n   409→          ? `🚨 ${overdueOrders.length} OVERDUE | 📦 ${approvedOrders.length} ready to ship, ${notApprovedOrders.length + awaitingUpsellOrders.length} pending - ${today}`\n   410→          : `📦 Daily Fulfillment Report: ${approvedOrders.length} approved, ${notApprovedOrders.length} not approved - ${today}`,\n   411→        text: emailBody\n   412→      })\n   413→    });\n   414→\n   415→    if (!emailRes.ok) {\n   416→      const err = await emailRes.text();\n   417→      throw new Error(`Email send failed: ${err}`);\n   418→    }\n   419→\n   420→    return new Response(JSON.stringify({ \n   421→      success: true,\n   422→      approvedOrderCount: approvedOrders.length,\n   423→      notApprovedOrderCount: notApprovedOrders.length,\n   424→      overdueCount: overdueOrders.length,\n   425→      awaitingUpsellCount: awaitingUpsellOrders.length,\n   426→      totalOrderCount: totalPendingOrders,\n   427→      sentAt: new Date().toISOString()\n   428→    }), {\n   429→      status: 200,\n   430→      headers: { 'Content-Type': 'application/json' }\n   431→    });\n   432→\n   433→  } catch (error) {\n   434→    console.error('Cron error:', error);\n   435→    return new Response(JSON.stringify({ error: error.message }), {\n   436→      status: 500,\n   437→      headers: { 'Content-Type': 'application/json' }\n   438→    });\n   439→  }\n   440→}\n   441→"}]},"parent_tool_use_id":"toolu_017mvnanq1AjPCYsckuzAEpV","session_id":"652984ef-afb7-4f4d-8ebb-d98b5eef4f87","uuid":"2e36a6c3-6c7e-42b1-83e0-7ceb05efb968"}
