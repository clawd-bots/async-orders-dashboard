{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M42GvZivsDFSFq6HPaRdTR","type":"tool_result","content":"   340→    // Use the LATER of approval date vs payment date (created_at approximates payment time)\n   341→    if (approvedAt && approvedAt > createdAt) {\n   342→      return order.approved_at;\n   343→    }\n   344→    return order.created_at;\n   345→  };\n   346→\n   347→  // FIFO batch allocation: assign earliest-expiring batch to each unit row\n   348→  const allocateBatches = (orderList) => {\n   349→    const remaining = {};\n   350→    for (const [sku, batches] of Object.entries(batchMap)) {\n   351→      remaining[sku] = batches.map(b => ({ ...b, remaining: b.quantity }));\n   352→    }\n   353→    const allocations = []; // parallel array to expanded rows\n   354→    for (const order of orderList) {\n   355→      const items = order.line_items?.length > 0 ? order.line_items : [{ title: '', sku: '', quantity: 1 }];\n   356→      for (const item of items) {\n   357→        const units = Math.max(item.quantity || 1, 1);\n   358→        for (let u = 0; u < units; u++) {\n   359→          const skuBatches = remaining[item.sku];\n   360→          if (skuBatches) {\n   361→            const batch = skuBatches.find(b => b.remaining > 0);\n   362→            if (batch) {\n   363→              allocations.push({ batch_number: batch.batch_number, expiry_date: batch.expiry_date });\n   364→              batch.remaining--;\n   365→            } else {\n   366→              allocations.push(null);\n   367→            }\n   368→          } else {\n   369→            allocations.push(null);\n   370→          }\n   371→        }\n   372→      }\n   373→    }\n   374→    return allocations;\n   375→  };\n   376→\n   377→  const getBatchExpiryColor = (expiryDate) => {\n   378→    if (!expiryDate) return C.gray;\n   379→    const days = (new Date(expiryDate) - new Date()) / (1000 * 60 * 60 * 24);\n   380→    if (days <= 7) return C.red;\n   381→    if (days <= 30) return C.yellow;\n   382→    if (days > 90) return C.green;\n   383→    return C.dark;\n   384→  };\n   385→\n   386→  const rawOrders = activeTab === 'approved' ? approvedOrders : notApprovedOrders;\n   387→  const summary = activeTab === 'approved' ? approvedSummary : notApprovedSummary;\n   388→  const tileCounts = getTileCounts();\n   389→\n   390→  // Sort approved orders by approved_at descending (most recent first)\n   391→  const sortedOrders = activeTab === 'approved'\n   392→    ? [...rawOrders].sort((a, b) => {\n   393→        const aDate = a.approved_at ? new Date(a.approved_at) : new Date(0);\n   394→        const bDate = b.approved_at ? new Date(b.approved_at) : new Date(0);\n   395→        return bDate - aDate;\n   396→      })\n   397→    : rawOrders;\n   398→\n   399→  // Overdue: delivery date BEFORE today, OR no-date approved before previous biz day's cutoff\n   400→  // Today's delivery date = Ship Today (NOT overdue) — matches tile logic\n   401→  const isOverdue = (o) => {\n   402→    const phtNow = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n   403→    const phtDay = phtNow.getDay();\n   404→    if (phtDay === 0) return false; // No fulfillment on Sundays\n   405→\n   406→    const todayPHT = new Date(phtNow.getFullYear(), phtNow.getMonth(), phtNow.getDate());\n   407→    \n   408→    if (o.preferred_delivery_date) {\n   409→      // Only PAST delivery dates are overdue — today's date is Ship Today\n   410→      const deliveryDate = new Date(o.preferred_delivery_date + 'T00:00:00');\n   411→      const deliveryDatePHT = new Date(deliveryDate.toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n   412→      const deliveryDateOnly = new Date(deliveryDatePHT.getFullYear(), deliveryDatePHT.getMonth(), deliveryDatePHT.getDate());\n   413→      return deliveryDateOnly < todayPHT;\n   414→    } else {\n   415→      // No delivery date: overdue if approved before previous biz day's cutoff\n   416→      const ref = getEffectiveApprovalDate(o);\n   417→      const prevBizDayOffset = phtDay === 1 ? 2 : 1;\n   418→      const isSH = (o.line_items || []).some(li => (li.product_type || '').toLowerCase().includes('erectile dysfunction'));\n   419→      const cutoffH = isSH ? 12 : 7.5;\n   420→      const yesterdayCutoff = new Date(phtNow);\n   421→      yesterdayCutoff.setDate(yesterdayCutoff.getDate() - prevBizDayOffset);\n   422→      yesterdayCutoff.setHours(Math.floor(cutoffH), (cutoffH % 1) * 60, 0, 0);\n   423→      const approvedPHT = new Date(new Date(ref).toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n   424→      return approvedPHT < yesterdayCutoff;\n   425→    }\n   426→  };\n   427→\n   428→  // Due Today: delivery date is today OR no-date orders approved between prev biz day cutoff and today's cutoff\n   429→  const isDueToday = (o) => {\n   430→    const phtNow2 = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n   431→    const phtDay2 = phtNow2.getDay();\n   432→    if (phtDay2 === 0) return false;\n   433→    const todayPHT2 = new Date(phtNow2.getFullYear(), phtNow2.getMonth(), phtNow2.getDate());\n   434→\n   435→    if (o.preferred_delivery_date) {\n   436→      const dd = new Date(o.preferred_delivery_date + 'T00:00:00');\n   437→      const ddPHT = new Date(dd.toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n   438→      const ddOnly = new Date(ddPHT.getFullYear(), ddPHT.getMonth(), ddPHT.getDate());\n   439→      return ddOnly.getTime() === todayPHT2.getTime();\n   440→    } else {\n   441→      // No delivery date: due today if approved between prev biz day's cutoff and today's cutoff\n   442→      const ref = getEffectiveApprovalDate(o);\n   443→      const prevBizDayOffset = phtDay2 === 1 ? 2 : 1;\n   444→      const isSH = (o.line_items || []).some(li => (li.product_type || '').toLowerCase().includes('erectile dysfunction'));\n   445→      const cutoffH = isSH ? 12 : 7.5;\n   446→      const yesterdayCutoff = new Date(phtNow2);\n   447→      yesterdayCutoff.setDate(yesterdayCutoff.getDate() - prevBizDayOffset);\n   448→      yesterdayCutoff.setHours(Math.floor(cutoffH), (cutoffH % 1) * 60, 0, 0);\n   449→      const todayCutoff = new Date(phtNow2);\n   450→      todayCutoff.setHours(Math.floor(cutoffH), (cutoffH % 1) * 60, 0, 0);\n   451→      const approvedPHT = new Date(new Date(ref).toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n   452→      return approvedPHT >= yesterdayCutoff && approvedPHT < todayCutoff;\n   453→    }\n   454→  };\n   455→\n   456→  // Apply filters (approved tab only)\n   457→  const orders = activeTab === 'approved'\n   458→    ? sortedOrders.filter(o => {\n   459→        const awaitingConsult = isAwaitingConsultation(o);\n   460→        if (deliveryFilter === 'awaiting_consult') return awaitingConsult;\n   461→        if (deliveryFilter === 'with_date') return !!o.preferred_delivery_date && !isDueToday(o) && !awaitingConsult;\n   462→        if (deliveryFilter === 'due_today') return (isDueToday(o) || isOverdue(o)) && !awaitingConsult;\n   463→        if (deliveryFilter === 'overdue') return isOverdue(o) && !awaitingConsult;\n   464→        return true;\n   465→      })\n   466→    : sortedOrders;\n   467→\n   468→  // Compute FIFO batch allocations for displayed approved orders\n   469→  const batchAllocations = activeTab === 'approved' ? allocateBatches(orders) : [];\n   470→\n   471→  // Filter counts for badges\n   472→  const phtNow = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Manila' }));\n   473→  const todayPHT = new Date(phtNow.getFullYear(), phtNow.getMonth(), phtNow.getDate());\n   474→  \n   475→  const awaitingConsultCount = approvedOrders.filter(o => isAwaitingConsultation(o)).length;\n   476→  const nonConsultOrders = approvedOrders.filter(o => !isAwaitingConsultation(o));\n   477→  const allWithDateCount = nonConsultOrders.filter(o => o.preferred_delivery_date && !isDueToday(o)).length;\