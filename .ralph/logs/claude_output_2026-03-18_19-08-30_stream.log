{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UNgKqypRjnJ6QhpMQotLCz","type":"tool_result","content":"   280→    });\n   281→\n   282→    // Calculate totals for approved\n   283→    const approvedValue = approvedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n   284→    const approvedItems = approvedOrders.reduce((sum, o) => \n   285→      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n   286→\n   287→    // Calculate totals for not approved  \n   288→    const notApprovedValue = notApprovedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n   289→    const notApprovedItems = notApprovedOrders.reduce((sum, o) =>\n   290→      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n   291→\n   292→    const overdueOrders = approvedOrders.filter(o => o.overdue);\n   293→    const awaitingUpsellValue = awaitingUpsellOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n   294→\n   295→    // Count old orders (3+ days) that DON'T have a scheduled delivery date\n   296→    const oldApprovedOrders = approvedOrders.filter(o => {\n   297→      const days = Math.floor((new Date() - new Date(o.created_at)) / (1000 * 60 * 60 * 24));\n   298→      return days >= 3 && !o.preferred_delivery_date;\n   299→    });\n   300→\n   301→    // Build friendly email message\n   302→    let emailBody = `Hi team! 👋\\n\\n`;\n   303→    emailBody += `Here's your daily fulfillment update for ${todayFormatted}.\\n\\n`;\n   304→\n   305→    if (overdueOrders.length > 0) {\n   306→      emailBody += `🚨 **OVERDUE: ${overdueOrders.length} order(s) past their fulfillment cutoff!**\\n\\n`;\n   307→    }\n   308→\n   309→    emailBody += `📦 **Ready to Ship (Approved)**\\n`;\n   310→    emailBody += `   ${approvedOrders.length} orders · PHP ${approvedValue.toLocaleString()} · ${approvedItems} items\\n\\n`;\n   311→    \n   312→    emailBody += `⏳ **Pending Approval**\\n`;\n   313→    emailBody += `   ${notApprovedOrders.length} orders · PHP ${notApprovedValue.toLocaleString()} · ${notApprovedItems} items\\n\\n`;\n   314→\n   315→    if (awaitingUpsellOrders.length > 0) {\n   316→      emailBody += `💰 **Awaiting Upsell Payment**\\n`;\n   317→      emailBody += `   ${awaitingUpsellOrders.length} orders · PHP ${awaitingUpsellValue.toLocaleString()}\\n\\n`;\n   318→    }\n   319→\n   320→    if (oldApprovedOrders.length > 0) {\n   321→      emailBody += `⚠️ Heads up: ${oldApprovedOrders.length} approved order(s) are 3+ days old and need attention!\\n\\n`;\n   322→    }\n   323→\n   324→    if (approvedOrders.length === 0) {\n   325→      emailBody += `Great news — all approved orders have been fulfilled! 🎉\\n\\n`;\n   326→    }\n   327→\n   328→    emailBody += `I've attached ${awaitingUpsellOrders.length > 0 ? 'three' : 'two'} CSV files with the full details:\\n`;\n   329→    emailBody += `• ATS_${dateStr}.csv — Approved orders ready to ship\\n`;\n   330→    emailBody += `• NOT_APPROVED_${dateStr}.csv — Orders pending approval\\n`;\n   331→    if (awaitingUpsellOrders.length > 0) {\n   332→      emailBody += `• AWAITING_UPSELL_${dateStr}.csv — Orders awaiting upsell payment\\n`;\n   333→    }\n   334→    emailBody += `\\n`;\n   335→    \n   336→    emailBody += `Let me know if you need anything else!\\n\\n`;\n   337→    emailBody += `— Edwin 🎩`;\n   338→\n   339→    // Send via AgentMail - using inboxes/messages endpoint for attachment support\n   340→    let emailRes;\n   341→    try {\n   342→      emailRes = await fetch('https://api.agentmail.to/v0/inboxes/edwin@mail.andyou.ph/messages/send', {\n   343→        method: 'POST',\n   344→        headers: {\n   345→          'Authorization': `Bearer ${agentmailKey}`,\n   346→          'Content-Type': 'application/json'\n   347→        },\n   348→        body: JSON.stringify({\n   349→          to: ['andrea@andyou.ph', 'karell@andyou.ph', 'bryan_bumanglag@andyou.ph'],\n   350→          cc: ['wesley@andyou.ph'],\n   351→          subject: overdueOrders.length > 0\n   352→            ? `🚨 ${overdueOrders.length} OVERDUE | 📦 ${approvedOrders.length} ready to ship, ${notApprovedOrders.length} pending`\n   353→            : `📦 Daily Fulfillment Report — ${approvedOrders.length} ready to ship, ${notApprovedOrders.length} pending`,\n   354→          text: emailBody,\n   355→          attachments: [\n   356→            {\n   357→              filename: `ATS_${dateStr}.csv`,\n   358→              content: btoa(unescape(encodeURIComponent(approvedCSV))),\n   359→              content_type: 'text/csv'\n   360→            },\n   361→            {\n   362→              filename: `NOT_APPROVED_${dateStr}.csv`,\n   363→              content: btoa(unescape(encodeURIComponent(notApprovedCSV))),\n   364→              content_type: 'text/csv'\n   365→            },\n   366→            ...(awaitingUpsellOrders.length > 0 ? [{\n   367→              filename: `AWAITING_UPSELL_${dateStr}.csv`,\n   368→              content: btoa(unescape(encodeURIComponent(generateCSV(awaitingUpsellOrders)))),\n   369→              content_type: 'text/csv'\n   370→            }] : [])\n   371→          ]\n   372→        })\n   373→      });\n   374→    } catch (fetchErr) {\n   375→      console.error('Fetch error:', fetchErr);\n   376→      throw new Error(`Email API fetch failed: ${fetchErr.message}`);\n   377→    }\n   378→\n   379→    if (!emailRes.ok) {\n   380→      const err = await emailRes.text();\n   381→      console.error('Email API error response:', err);\n   382→      throw new Error(`Email send failed (${emailRes.status}): ${err}`);\n   383→    }\n   384→\n   385→    res.json({\n   386→      success: true,\n   387→      message: `Email sent with ${awaitingUpsellOrders.length > 0 ? 3 : 2} CSV attachments! ${approvedOrders.length} approved, ${notApprovedOrders.length} pending.`,\n   388→      approved: approvedOrders.length,\n   389→      notApproved: notApprovedOrders.length,\n   390→      awaitingUpsell: awaitingUpsellOrders.length,\n   391→      overdueCount: overdueOrders.length\n   392→    });\n   393→\n   394→  } catch (error) {\n   395→    console.error('Error:', error);\n   396→    res.status(500).json({ error: error.message });\n   397→  }\n   398→}\n   399→"}]},"parent_tool_use_id":null,"session_id":"652984ef-afb7-4f4d-8ebb-d98b5eef4f87","uuid":"36ac2a60-400a-41b0-a900-dc2cac72a7b7","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/async-orders-dashboard/api/send-email.js","content":"    });\n\n    // Calculate totals for approved\n    const approvedValue = approvedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n    const approvedItems = approvedOrders.reduce((sum, o) => \n      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n\n    // Calculate totals for not approved  \n    const notApprovedValue = notApprovedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n    const notApprovedItems = notApprovedOrders.reduce((sum, o) =>\n      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n\n    const overdueOrders = approvedOrders.filter(o => o.overdue);\n    const awaitingUpsellValue = awaitingUpsellOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n\n    // Count old orders (3+ days) that DON'T have a scheduled delivery date\n    const oldApprovedOrders = approvedOrders.filter(o => {\n      const days = Math.floor((new Date() - new Date(o.created_at)) / (1000 * 60 * 60 * 24));\n      return days >= 3 && !o.preferred_delivery_date;\n    });\n\n    // Build friendly email message\n    let emailBody = `Hi team! 👋\\n\\n`;\n    emailBody += `Here's your daily fulfillment update for ${todayFormatted}.\\n\\n`;\n\n    if (overdueOrders.length > 0) {\n      emailBody += `🚨 **OVERDUE: ${overdueOrders.length} order(s) past their fulfillment cutoff!**\\n\\n`;\n    }\n\n    emailBody += `📦 **Ready to Ship (Approved)**\\n`;\n    emailBody += `   ${approvedOrders.length} orders · PHP ${approvedValue.toLocaleString()} · ${approvedItems} items\\n\\n`;\n    \n    emailBody += `⏳ **Pending Approval**\\n`;\n    emailBody += `   ${notApprovedOrders.length} orders · PHP ${notApprovedValue.toLocaleString()} · ${notApprovedItems} items\\n\\n`;\n\n    if (awaitingUpsellOrders.length > 0) {\n      emailBody += `💰 **Awaiting Upsell Payment**\\n`;\n      emailBody += `   ${awaitingUpsellOrders.length} orders · PHP ${awaitingUpsellValue.toLocaleString()}\\n\\n`;\n    }\n\n    if (oldApprovedOrders.length > 0) {\n      emailBody += `⚠️ Heads up: ${oldApprovedOrders.length} approved order(s) are 3+ days old and need attention!\\n\\n`;\n    }\n\n    if (approvedOrders.length === 0) {\n      emailBody += `Great news — all approved orders have been fulfilled! 🎉\\n\\n`;\n    }\n\n    emailBody += `I've attached ${awaitingUpsellOrders.length > 0 ? 'three' : 'two'} CSV files with the full details:\\n`;\n    emailBody += `• ATS_${dateStr}.csv — Approved orders ready to ship\\n`;\n    emailBody += `• NOT_APPROVED_${dateStr}.csv — Orders pending approval\\n`;\n    if (awaitingUpsellOrders.length > 0) {\n      emailBody += `• AWAITING_UPSELL_${dateStr}.csv — Orders awaiting upsell payment\\n`;\n    }\n    emailBody += `\\n`;\n    \n    emailBody += `Let me know if you need anything else!\\n\\n`;\n    emailBody += `— Edwin 🎩`;\n\n    // Send via AgentMail - using inboxes/messages endpoint for attachment support\n    let emailRes;\n    try {\n      emailRes = await fetch('https://api.agentmail.to/v0/inboxes/edwin@mail.andyou.ph/messages/send', {\n        method: 'POST',\n        headers: {\n          'Authorization': `Bearer ${agentmailKey}`,\n          'Content-Type': 'application/json'\n        },\n        body: JSON.stringify({\n          to: ['andrea@andyou.ph', 'karell@andyou.ph', 'bryan_bumanglag@andyou.ph'],\n          cc: ['wesley@andyou.ph'],\n          subject: overdueOrders.length > 0\n            ? `🚨 ${overdueOrders.length} OVERDUE | 📦 ${approvedOrders.length} ready to ship, ${notApprovedOrders.length} pending`\n            : `📦 Daily Fulfillment Report — ${approvedOrders.length} ready to ship, ${notApprovedOrders.length} pending`,\n          text: emailBody,\n          attachments: [\n            {\n              filename: `ATS_${dateStr}.csv`,\n              content: btoa(unescape(encodeURIComponent(approvedCSV))),\n              content_type: 'text/csv'\n            },\n            {\n              filename: `NOT_APPROVED_${dateStr}.csv`,\n              content: btoa(unescape(encodeURIComponent(notApprovedCSV))),\n              content_type: 'text/csv'\n            },\n            ...(awaitingUpsellOrders.length > 0 ? [{\n              filename: `AWAITING_UPSELL_${dateStr}.csv`,\n              content: btoa(unescape(encodeURIComponent(generateCSV(awaitingUpsellOrders)))),\n              content_type: 'text/csv'\n            }] : [])\n          ]\n        })\n      });\n    } catch (fetchErr) {\n      console.error('Fetch error:', fetchErr);\n      throw new Error(`Email API fetch failed: ${fetchErr.message}`);\n    }\n\n    if (!emailRes.ok) {\n      const err = await emailRes.text();\n      console.error('Email API error response:', err);\n      throw new Error(`Email send failed (${emailRes.status}): ${err}`);\n    }\n\n    res.json({\n      success: true,\n      message: `Email sent with ${awaitingUpsellOrders.length > 0 ? 3 : 2} CSV attachments! ${approvedOrders.length} approved, ${notApprovedOrders.length} pending.`,\n      approved: approvedOrders.length,\n      notApproved: notApprovedOrders.length,\n      awaitingUpsell: awaitingUpsellOrders.length,\n      overdueCount: overdueOrders.length\n    });\n\n  } catch (error) {\n    console.error('Error:', error);\n    res.status(500).json({ error: error.message });\n  }\n}\n","numLines":120,"startLine":280,"totalLines":399}}}
