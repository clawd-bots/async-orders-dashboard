{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FuKfomVrcj2eYeKmxyKgYN","type":"tool_result","content":"     1→// Send daily fulfillment report email with CSV attachments\n     2→export default async function handler(req, res) {\n     3→  const storeUrl = process.env.SHOPIFY_STORE_URL;\n     4→  const accessToken = process.env.SHOPIFY_ACCESS_TOKEN;\n     5→  const agentmailKey = process.env.AGENTMAIL_API_KEY;\n     6→\n     7→  if (!storeUrl || !accessToken) {\n     8→    return res.status(400).json({ error: 'Shopify API not configured' });\n     9→  }\n    10→\n    11→  if (!agentmailKey) {\n    12→    return res.status(400).json({ error: 'AgentMail API not configured' });\n    13→  }\n    14→\n    15→  try {\n    16→    // Use GraphQL to fetch orders\n    17→    const graphqlUrl = `https://${storeUrl}/admin/api/2024-01/graphql.json`;\n    18→    \n    19→    const query = `\n    20→      {\n    21→        orders(first: 250, sortKey: CREATED_AT, reverse: true, query: \"fulfillment_status:unfulfilled financial_status:paid\") {\n    22→          edges {\n    23→            node {\n    24→              id\n    25→              name\n    26→              createdAt\n    27→              totalPriceSet {\n    28→                shopMoney {\n    29→                  amount\n    30→                  currencyCode\n    31→                }\n    32→              }\n    33→              customer {\n    34→                firstName\n    35→                lastName\n    36→                email\n    37→              }\n    38→              shippingAddress {\n    39→                phone\n    40→                address1\n    41→                address2\n    42→                city\n    43→                province\n    44→                zip\n    45→              }\n    46→              lineItems(first: 10) {\n    47→                edges {\n    48→                  node {\n    49→                    title\n    50→                    variantTitle\n    51→                    quantity\n    52→                    sku\n    53→                    fulfillableQuantity\n    54→                  }\n    55→                }\n    56→              }\n    57→              metafield(namespace: \"custom\", key: \"approved_to_ship\") {\n    58→                value\n    59→                updatedAt\n    60→              }\n    61→              preferredDeliveryMetafield: metafield(namespace: \"custom\", key: \"preferred_delivery\") {\n    62→                value\n    63→              }\n    64→              preferredDeliveryDateMetafield: metafield(namespace: \"custom\", key: \"preferred_delivery_data\") {\n    65→                value\n    66→              }\n    67→              prescriptionStatusMetafield: metafield(namespace: \"custom\", key: \"prescription_status\") {\n    68→                value\n    69→              }\n    70→              consultationStatusMetafield: metafield(namespace: \"custom\", key: \"consultation_status\") {\n    71→                value\n    72→                updatedAt\n    73→              }\n    74→              orderStatusMetafield: metafield(namespace: \"custom\", key: \"order_status\") {\n    75→                value\n    76→              }\n    77→              upsellMetafield: metafield(namespace: \"custom\", key: \"upsell\") {\n    78→                value\n    79→              }\n    80→              upsellPaidMetafield: metafield(namespace: \"custom\", key: \"upsell_paid\") {\n    81→                value\n    82→                updatedAt\n    83→              }\n    84→              discountCodes\n    85→            }\n    86→          }\n    87→        }\n    88→      }\n    89→    `;\n    90→\n    91→    const shopifyRes = await fetch(graphqlUrl, {\n    92→      method: 'POST',\n    93→      headers: {\n    94→        'X-Shopify-Access-Token': accessToken,\n    95→        'Content-Type': 'application/json'\n    96→      },\n    97→      body: JSON.stringify({ query })\n    98→    });\n    99→\n   100→    if (!shopifyRes.ok) {\n   101→      throw new Error(`Shopify API error: ${shopifyRes.status}`);\n   102→    }\n   103→\n   104→    const data = await shopifyRes.json();\n   105→    \n   106→    if (data.errors) {\n   107→      throw new Error(data.errors[0]?.message || 'GraphQL error');\n   108→    }\n   109→\n   110→    // Process all orders, exclude Keevtest\n   111→    const allOrders = data.data?.orders?.edges || [];\n   112→    const filteredOrders = allOrders\n   113→      .filter(edge => {\n   114→        const discountCodes = edge.node.discountCodes || [];\n   115→        const hasKeevtest = discountCodes.some(code => \n   116→          code?.toLowerCase?.().includes('keevtest')\n   117→        );\n   118→        if (hasKeevtest) return false;\n   119→        \n   120→        // Exclude orders with Order Status = \"Manually Refunded\"\n   121→        const orderStatus = edge.node.orderStatusMetafield?.value?.toLowerCase?.() || '';\n   122→        if (orderStatus.includes('manually refunded')) return false;\n   123→        \n   124→        return true;\n   125→      })\n   126→      .map(edge => {\n   127→        const node = edge.node;\n   128→        const metafield = node.metafield;\n   129→        const val = metafield?.value?.toLowerCase?.() || '';\n   130→        let approvedToShip = null;\n   131→        if (val === 'true' || val === '1' || val === 'yes') approvedToShip = true;\n   132→        else if (val === 'false' || val === '0' || val === 'no') approvedToShip = false;\n   133→        const approvedAt = approvedToShip === true ? (metafield?.updatedAt || null) : null;\n   134→        \n   135→        const pdVal = node.preferredDeliveryMetafield?.value?.toLowerCase?.() || '';\n   136→        let preferredDelivery = null;\n   137→        if (pdVal === 'true' || pdVal === '1' || pdVal === 'yes') preferredDelivery = true;\n   138→        else if (pdVal === 'false' || pdVal === '0' || pdVal === 'no') preferredDelivery = false;\n   139→\n   140→        return {\n   141→          name: node.name,\n   142→          created_at: node.createdAt,\n   143→          total_price: node.totalPriceSet?.shopMoney?.amount,\n   144→          currency: node.totalPriceSet?.shopMoney?.currencyCode,\n   145→          approved_to_ship: approvedToShip,\n   146→          approved_at: approvedAt,\n   147→          preferred_delivery: preferredDelivery,\n   148→          preferred_delivery_date: node.preferredDeliveryDateMetafield?.value || null,\n   149→          prescription_status: node.prescriptionStatusMetafield?.value || null,\n   150→          consultation_status: (() => {\n   151→            try {\n   152→              const raw = node.consultationStatusMetafield?.value;\n   153→              if (!raw) return null;\n   154→              const parsed = JSON.parse(raw);\n   155→              return Array.isArray(parsed) ? parsed[0] : parsed;\n   156→            } catch { return node.consultationStatusMetafield?.value || null; }\n   157→          })(),\n   158→          consultation_status_updated_at: node.consultationStatusMetafield?.updatedAt || null,\n   159→          upsell: (() => {\n   160→            const v = node.upsellMetafield?.value?.toLowerCase?.() || '';\n   161→            if (v === 'true' || v === '1' || v === 'yes') return true;\n   162→            if (v === 'false' || v === '0' || v === 'no') return false;\n   163→            return null;\n   164→          })(),\n   165→          upsell_paid: (() => {\n   166→            const v = node.upsellPaidMetafield?.value?.toLowerCase?.() || '';\n   167→            if (v === 'true' || v === '1' || v === 'yes') return true;\n   168→            if (v === 'false' || v === '0' || v === 'no') return false;\n   169→            return null;\n   170→          })(),\n   171→          upsell_paid_at: (() => {\n   172→            const v = node.upsellPaidMetafield?.value?.toLowerCase?.() || '';\n   173→            return (v === 'true' || v === '1' || v === 'yes') ? (node.upsellPaidMetafield?.updatedAt || null) : null;\n   174→          })(),\n   175→          customer: {\n   176→            first_name: node.customer?.firstName,\n   177→            last_name: node.customer?.lastName,\n   178→            email: node.customer?.email\n   179→          },\n   180→          shipping_address: node.shippingAddress ? {\n   181→            phone: node.shippingAddress.phone || '',\n   182→            address1: node.shippingAddress.address1 || '',\n   183→            address2: node.shippingAddress.address2 || '',\n   184→            city: node.shippingAddress.city || '',\n   185→            province: node.shippingAddress.province || '',\n   186→            zip: node.shippingAddress.zip || '',\n   187→          } : null,\n   188→          is_provincial: node.shippingAddress?.province ? !['Metro Manila', 'NCR', 'National Capital Region'].some(m => (node.shippingAddress?.province || '').toLowerCase().includes(m.toLowerCase())) : false,\n   189→          line_items: (node.lineItems?.edges?.map(e => ({\n   190→            title: e.node.variantTitle && e.node.variantTitle !== 'Default Title' ? `${e.node.title} — ${e.node.variantTitle}` : e.node.title,\n   191→            quantity: e.node.fulfillableQuantity ?? e.node.quantity,\n   192→            sku: e.node.sku || '',\n   193→            fulfillable_quantity: e.node.fulfillableQuantity ?? e.node.quantity\n   194→          })) || []).filter(li => li.fulfillable_quantity > 0)\n   195→        };\n   196→      });\n   197→\n   198→    // Overdue helper\n   199→    const getNextCutoffAfter = (date) => {\n   200→      const d = new Date(date);\n   201→      const phtDate = new Date(d.getTime() + 8 * 3600000);\n   202→      const year = phtDate.getUTCFullYear();\n   203→      const month = phtDate.getUTCMonth();\n   204→      const day = phtDate.getUTCDate();\n   205→      const cutoff7am = new Date(Date.UTC(year, month, day, 7, 0, 0) - 8 * 3600000);\n   206→      const cutoff12pm = new Date(Date.UTC(year, month, day, 12, 0, 0) - 8 * 3600000);\n   207→      if (d < cutoff7am) return cutoff7am;\n   208→      if (d < cutoff12pm) return cutoff12pm;\n   209→      return new Date(Date.UTC(year, month, day + 1, 7, 0, 0) - 8 * 3600000);\n   210→    };\n   211→\n   212→    const isOrderOverdue = (order) => {\n   213→      let startTime;\n   214→      if (order.upsell === true) {\n   215→        if (!order.upsell_paid) return false;\n   216→        startTime = new Date(order.upsell_paid_at);\n   217→      } else {\n   218→        if (!order.approved_at) return false;\n   219→        startTime = new Date(order.approved_at);\n   220→      }\n   221→      return new Date() > getNextCutoffAfter(startTime);\n   222→    };\n   223→\n   224→    // Split into approved and not approved (explicitly false only, exclude blanks)\n   225→    const approvedOrders = filteredOrders\n   226→      .filter(o => {\n   227→        if (o.approved_to_ship !== true) return false;\n   228→        if (o.upsell === true) return o.upsell_paid === true;\n   229→        return true;\n   230→      })\n   231→      .map(o => ({ ...o, overdue: isOrderOverdue(o) }));\n   232→    const awaitingUpsellOrders = filteredOrders\n   233→      .filter(o => o.approved_to_ship === true && o.upsell === true && o.upsell_paid !== true);\n   234→    const notApprovedOrders = filteredOrders.filter(o => {\n   235→      if (o.approved_to_ship !== false) return false;\n   236→      const ps = o.prescription_status || '';\n   237→      if (ps.toLowerCase().includes('on hold') || ps.toLowerCase().includes('on_hold')) return false;\n   238→      return true;\n   239→    });\n   240→\n   241→    // Generate CSV content\n   242→    const generateCSV = (orders) => {\n   243→      const headers = ['Order Number', 'Date', 'Customer', 'Email', 'Phone', 'Product', 'SKU', 'Qty', 'Shipping Address', 'Preferred Delivery', 'Delivery Date', 'Approved On', 'Upsell', 'Upsell Paid', 'Upsell Paid Date', 'Overdue', 'Shipped'];\n   244→      