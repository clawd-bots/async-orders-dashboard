{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UmZkCUsQvLoBJ4Foyqrnes","type":"tool_result","content":"     1→// Send daily fulfillment report email with CSV attachments\n     2→export default async function handler(req, res) {\n     3→  const storeUrl = process.env.SHOPIFY_STORE_URL;\n     4→  const accessToken = process.env.SHOPIFY_ACCESS_TOKEN;\n     5→  const agentmailKey = process.env.AGENTMAIL_API_KEY;\n     6→\n     7→  if (!storeUrl || !accessToken) {\n     8→    return res.status(400).json({ error: 'Shopify API not configured' });\n     9→  }\n    10→\n    11→  if (!agentmailKey) {\n    12→    return res.status(400).json({ error: 'AgentMail API not configured' });\n    13→  }\n    14→\n    15→  try {\n    16→    // Use GraphQL to fetch orders\n    17→    const graphqlUrl = `https://${storeUrl}/admin/api/2024-01/graphql.json`;\n    18→    \n    19→    const query = `\n    20→      {\n    21→        orders(first: 250, sortKey: CREATED_AT, reverse: true, query: \"fulfillment_status:unfulfilled financial_status:paid\") {\n    22→          edges {\n    23→            node {\n    24→              id\n    25→              name\n    26→              createdAt\n    27→              totalPriceSet {\n    28→                shopMoney {\n    29→                  amount\n    30→                  currencyCode\n    31→                }\n    32→              }\n    33→              customer {\n    34→                firstName\n    35→                lastName\n    36→                email\n    37→              }\n    38→              shippingAddress {\n    39→                phone\n    40→                address1\n    41→                address2\n    42→                city\n    43→                province\n    44→                zip\n    45→              }\n    46→              lineItems(first: 10) {\n    47→                edges {\n    48→                  node {\n    49→                    title\n    50→                    variantTitle\n    51→                    quantity\n    52→                    sku\n    53→                    fulfillableQuantity\n    54→                  }\n    55→                }\n    56→              }\n    57→              metafield(namespace: \"custom\", key: \"approved_to_ship\") {\n    58→                value\n    59→                updatedAt\n    60→              }\n    61→              preferredDeliveryMetafield: metafield(namespace: \"custom\", key: \"preferred_delivery\") {\n    62→                value\n    63→              }\n    64→              preferredDeliveryDateMetafield: metafield(namespace: \"custom\", key: \"preferred_delivery_data\") {\n    65→                value\n    66→              }\n    67→              prescriptionStatusMetafield: metafield(namespace: \"custom\", key: \"prescription_status\") {\n    68→                value\n    69→              }\n    70→              consultationStatusMetafield: metafield(namespace: \"custom\", key: \"consultation_status\") {\n    71→                value\n    72→                updatedAt\n    73→              }\n    74→              orderStatusMetafield: metafield(namespace: \"custom\", key: \"order_status\") {\n    75→                value\n    76→              }\n    77→              discountCodes\n    78→            }\n    79→          }\n    80→        }\n    81→      }\n    82→    `;\n    83→\n    84→    const shopifyRes = await fetch(graphqlUrl, {\n    85→      method: 'POST',\n    86→      headers: {\n    87→        'X-Shopify-Access-Token': accessToken,\n    88→        'Content-Type': 'application/json'\n    89→      },\n    90→      body: JSON.stringify({ query })\n    91→    });\n    92→\n    93→    if (!shopifyRes.ok) {\n    94→      throw new Error(`Shopify API error: ${shopifyRes.status}`);\n    95→    }\n    96→\n    97→    const data = await shopifyRes.json();\n    98→    \n    99→    if (data.errors) {\n   100→      throw new Error(data.errors[0]?.message || 'GraphQL error');\n   101→    }\n   102→\n   103→    // Process all orders, exclude Keevtest\n   104→    const allOrders = data.data?.orders?.edges || [];\n   105→    const filteredOrders = allOrders\n   106→      .filter(edge => {\n   107→        const discountCodes = edge.node.discountCodes || [];\n   108→        const hasKeevtest = discountCodes.some(code => \n   109→          code?.toLowerCase?.().includes('keevtest')\n   110→        );\n   111→        if (hasKeevtest) return false;\n   112→        \n   113→        // Exclude orders with Order Status = \"Manually Refunded\"\n   114→        const orderStatus = edge.node.orderStatusMetafield?.value?.toLowerCase?.() || '';\n   115→        if (orderStatus.includes('manually refunded')) return false;\n   116→        \n   117→        return true;\n   118→      })\n   119→      .map(edge => {\n   120→        const node = edge.node;\n   121→        const metafield = node.metafield;\n   122→        const val = metafield?.value?.toLowerCase?.() || '';\n   123→        let approvedToShip = null;\n   124→        if (val === 'true' || val === '1' || val === 'yes') approvedToShip = true;\n   125→        else if (val === 'false' || val === '0' || val === 'no') approvedToShip = false;\n   126→        const approvedAt = approvedToShip === true ? (metafield?.updatedAt || null) : null;\n   127→        \n   128→        const pdVal = node.preferredDeliveryMetafield?.value?.toLowerCase?.() || '';\n   129→        let preferredDelivery = null;\n   130→        if (pdVal === 'true' || pdVal === '1' || pdVal === 'yes') preferredDelivery = true;\n   131→        else if (pdVal === 'false' || pdVal === '0' || pdVal === 'no') preferredDelivery = false;\n   132→\n   133→        return {\n   134→          name: node.name,\n   135→          created_at: node.createdAt,\n   136→          total_price: node.totalPriceSet?.shopMoney?.amount,\n   137→          currency: node.totalPriceSet?.shopMoney?.currencyCode,\n   138→          approved_to_ship: approvedToShip,\n   139→          approved_at: approvedAt,\n   140→          preferred_delivery: preferredDelivery,\n   141→          preferred_delivery_date: node.preferredDeliveryDateMetafield?.value || null,\n   142→          prescription_status: node.prescriptionStatusMetafield?.value || null,\n   143→          consultation_status: (() => {\n   144→            try {\n   145→              const raw = node.consultationStatusMetafield?.value;\n   146→              if (!raw) return null;\n   147→              const parsed = JSON.parse(raw);\n   148→              return Array.isArray(parsed) ? parsed[0] : parsed;\n   149→            } catch { return node.consultationStatusMetafield?.value || null; }\n   150→          })(),\n   151→          consultation_status_updated_at: node.consultationStatusMetafield?.updatedAt || null,\n   152→          customer: {\n   153→            first_name: node.customer?.firstName,\n   154→            last_name: node.customer?.lastName,\n   155→            email: node.customer?.email\n   156→          },\n   157→          shipping_address: node.shippingAddress ? {\n   158→            phone: node.shippingAddress.phone || '',\n   159→            address1: node.shippingAddress.address1 || '',\n   160→            address2: node.shippingAddress.address2 || '',\n   161→            city: node.shippingAddress.city || '',\n   162→            province: node.shippingAddress.province || '',\n   163→            zip: node.shippingAddress.zip || '',\n   164→          } : null,\n   165→          is_provincial: node.shippingAddress?.province ? !['Metro Manila', 'NCR', 'National Capital Region'].some(m => (node.shippingAddress?.province || '').toLowerCase().includes(m.toLowerCase())) : false,\n   166→          line_items: (node.lineItems?.edges?.map(e => ({\n   167→            title: e.node.variantTitle && e.node.variantTitle !== 'Default Title' ? `${e.node.title} — ${e.node.variantTitle}` : e.node.title,\n   168→            quantity: e.node.fulfillableQuantity ?? e.node.quantity,\n   169→            sku: e.node.sku || '',\n   170→            fulfillable_quantity: e.node.fulfillableQuantity ?? e.node.quantity\n   171→          })) || []).filter(li => li.fulfillable_quantity > 0)\n   172→        };\n   173→      });\n   174→\n   175→    // Split into approved and not approved (explicitly false only, exclude blanks)\n   176→    const approvedOrders = filteredOrders.filter(o => o.approved_to_ship === true);\n   177→    const notApprovedOrders = filteredOrders.filter(o => {\n   178→      if (o.approved_to_ship !== false) return false;\n   179→      const ps = o.prescription_status || '';\n   180→      if (ps.toLowerCase().includes('on hold') || ps.toLowerCase().includes('on_hold')) return false;\n   181→      return true;\n   182→    });\n   183→\n   184→    // Generate CSV content\n   185→    const generateCSV = (orders) => {\n   186→      const headers = ['Order Number', 'Date', 'Customer', 'Email', 'Phone', 'Product', 'SKU', 'Qty', 'Shipping Address', 'Preferred Delivery', 'Delivery Date', 'Approved On', 'Shipped'];\n   187→      const rows = orders.flatMap(o => \n   188→        (o.line_items?.length > 0 ? o.line_items : [{ title: '', sku: '', quantity: 0 }]).flatMap(item =>\n   189→          Array.from({ length: Math.max(item.quantity || 1, 1) }, () => [\n   190→            o.name,\n   191→            new Date(o.created_at).toLocaleDateString('en-PH'),\n   192→            `${o.customer?.first_name || ''} ${o.customer?.last_name || ''}`.trim() || 'Guest',\n   193→            o.customer?.email || '',\n   194→            o.shipping_address?.phone || '',\n   195→            item.title || '',\n   196→            item.sku || '',\n   197→            1,\n   198→            o.shipping_address ? `${o.shipping_address.address1 || ''}${o.shipping_address.address2 ? ', ' + o.shipping_address.address2 : ''}, ${o.shipping_address.city || ''}, ${o.shipping_address.province || ''} ${o.shipping_address.zip || ''}` : '',\n   199→            o.preferred_delivery === true ? 'Yes' : o.preferred_delivery === false ? 'No' : '',\n   200→            o.preferred_delivery_date || '',\n   201→            o.approved_at ? new Date(o.approved_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) : '',\n   202→            'No'\n   203→          ])\n   204→        )\n   205→      );\n   206→      \n   207→      return [headers, ...rows]\n   208→        .map(r => r.map(c => `\"${(c || '').toString().replace(/\"/g, '\"\"')}\"`).join(','))\n   209→        .join('\\n');\n   210→    };\n   211→\n   212→    const approvedCSV = generateCSV(approvedOrders);\n   213→    const notApprovedCSV = generateCSV(notApprovedOrders);\n   214→\n   215→    // Date for filenames\n   216→    const dateStr = new Date().toISOString().split('T')[0].replace(/-/g, '');\n   217→    const todayFormatted = new Date().toLocaleDateString('en-PH', { \n   218→      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' \n   219→    });\n   220→\n   221→    // Calculate totals for approved\n   222→    const approvedValue = approvedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n   223→    const approvedItems = approvedOrders.reduce((sum, o) => \n   224→      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n   225→\n   226→    // Calculate totals for not approved  \n   227→    const notApprovedValue = notApprovedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n   228→    const notApprovedItems = notApprovedOrders.reduce((sum, o) => \n   229→      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n   230→\n   231→    // Count old orders (3+ days) that DON'T have a scheduled delivery date\n   232→    const oldApprovedOrders = approvedOrders.filter(o => {\n   233→      const days = Math.floor((new Date() - new Date(o.created_at)) / (1000 * 60 * 60 * 24));\n   234→      return days >= 3 && !o.preferred_delivery_date;\n   235→    });\n   236→\n   237→    // Build friendly email message\n   238→    let emailBody = `Hi team! 👋\\n\\n`;\n   239→    emailBody += `Here's your daily fulfillment update for ${todayFormatted}.\\n\\n`;\n   240→    \n   241→    emailBody += `📦 **Ready to Ship (Approved)**\\n`;\n   242→    emailBody += `   ${approvedOrders.length} orders · PHP ${approvedValue.toLocaleString()} · ${approvedItems} items\\n\\n`;\n   243→    \n   244→    emailBody += `⏳ **Pending Approval**\\n`;\n   245→    emailBody += `   ${notApprovedOrders.length} orders · PHP ${notApprovedValue.toLocaleString()} · ${notApprovedItems} items\\n\\n`;\n   246→\n   247→    if (oldApprovedOrders.length > 0) {\n   248→      emailBody += `⚠️ Heads up: ${oldApprovedOrders.length} approved order(s) are 3+ days old and need attention!\\n\\n`;\n   249→    }\n   250→\n   251→    if (approvedOrders.length === 0) {\n   252→      emailBody += `Great news — all approved orders have been fulfilled! 🎉\\n\\n`;\n   253→    }\n   254→\n   255→    emailBody += `I've attached two CSV files with the full details:\\n`;\n   256→    emailBody += `• ATS_${dateStr}.csv — Approved orders ready to ship\\n`;\n   257→    emailBody += `• NOT_APPROVED_${dateStr}.csv — Orders pending approval\\n\\n`;\n   258→    \n   259→    emailBody += `Let me know if you need anything else!\\n\\n`;\n   260→    emailBody += `— Edwin 🎩`;\n   261→\n   262→    // Send via AgentMail - using inboxes/messages endpoint for attachment support\n   263→    let emailRes;\n   264→    try {\n   265→      emailRes = await fetch('https://api.agentmail.to/v0/inboxes/edwin@mail.andyou.ph/messages/send', {\n   266→        method: 'POST',\n   267→        headers: {\n   268→          'Authorization': `Bearer ${agentmailKey}`,\n   269→          'Content-Type': 'application/json'\n   270→        },\n   271→        body: JSON.stringify({\n   272→          to: ['andrea@andyou.ph', 'karell@andyou.ph', 'bryan_bumanglag@andyou.ph'],\n   273→          cc: ['wesley@andyou.ph'],\n   274→          subject: `📦 Daily Fulfillment Report — ${approvedOrders.length} ready to ship, ${notApprovedOrders.length} pending`,\n   275→          text: emailBody,\n   276→          attachments: [\n   277→            {\n   278→              filename: `ATS_${dateStr}.csv`,\n   279→              content: btoa(unescape(encodeURIComponent(approvedCSV))),\n   280→              content_type: 'text/csv'\n   281→            },\n   282→            {\n   283→              filename: `NOT_APPROVED_${dateStr}.csv`,\n   284→              content: btoa(unescape(encodeURIComponent(notApprovedCSV))),\n   285→              content_type: 'text/csv'\n   286→            }\n   287→          ]\n   288→        })\n   289→      });\n   290→    } catch (fetchErr) {\n   291→      console.error('Fetch error:', fetchErr);\n   292→      throw new Error(`Email API fetch failed: ${fetchErr.message}`);\n   293→    }\n   294→\n   295→    if (!emailRes.ok) {\n   296→      const err = await emailRes.text();\n   297→      console.error('Email API error response:', err);\n   298→      throw new Error(`Email send failed (${emailRes.status}): ${err}`);\n   299→    }\n   300→\n   301→    res.json({ \n   302→      success: true, \n   303→      message: `Email sent with 2 CSV attachments! ${approvedOrders.length} approved, ${notApprovedOrders.length} pending.`,\n   304→      approved: approvedOrders.length,\n   305→      notApproved: notApprovedOrders.length\n   306→    });\n   307→\n   308→  } catch (error) {\n   309→    console.error('Error:', error);\n   310→    res.status(500).json({ error: error.message });\n   311→  }\n   312→}\n   313→"}]},"parent_tool_use_id":"toolu_01KHFL1MSzJQsR3HBYUXN3PJ","session_id":"652984ef-afb7-4f4d-8ebb-d98b5eef4f87","uuid":"9dc65c3e-9432-4a53-a718-d91a8d82f754"}
