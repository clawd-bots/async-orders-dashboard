oval**\\n`;\n   313→    emailBody += `   ${notApprovedOrders.length} orders · PHP ${notApprovedValue.toLocaleString()} · ${notApprovedItems} items\\n\\n`;\n   314→\n   315→    if (awaitingUpsellOrders.length > 0) {\n   316→      emailBody += `💰 **Awaiting Upsell Payment**\\n`;\n   317→      emailBody += `   ${awaitingUpsellOrders.length} orders · PHP ${awaitingUpsellValue.toLocaleString()}\\n\\n`;\n   318→    }\n   319→\n   320→    if (oldApprovedOrders.length > 0) {\n   321→      emailBody += `⚠️ Heads up: ${oldApprovedOrders.length} approved order(s) are 3+ days old and need attention!\\n\\n`;\n   322→    }\n   323→\n   324→    if (approvedOrders.length === 0) {\n   325→      emailBody += `Great news — all approved orders have been fulfilled! 🎉\\n\\n`;\n   326→    }\n   327→\n   328→    emailBody += `I've attached ${awaitingUpsellOrders.length > 0 ? 'three' : 'two'} CSV files with the full details:\\n`;\n   329→    emailBody += `• ATS_${dateStr}.csv — Approved orders ready to ship\\n`;\n   330→    emailBody += `• NOT_APPROVED_${dateStr}.csv — Orders pending approval\\n`;\n   331→    if (awaitingUpsellOrders.length > 0) {\n   332→      emailBody += `• AWAITING_UPSELL_${dateStr}.csv — Orders awaiting upsell payment\\n`;\n   333→    }\n   334→    emailBody += `\\n`;\n   335→    \n   336→    emailBody += `Let me know if you need anything else!\\n\\n`;\n   337→    emailBody += `— Edwin 🎩`;\n   338→\n   339→    // Send via AgentMail - using inboxes/messages endpoint for attachment support\n   340→    let emailRes;\n   341→    try {\n   342→      emailRes = await fetch('https://api.agentmail.to/v0/inboxes/edwin@mail.andyou.ph/messages/send', {\n   343→        method: 'POST',\n   344→        headers: {\n   345→          'Authorization': `Bearer ${agentmailKey}`,\n   346→          'Content-Type': 'application/json'\n   347→        },\n   348→        body: JSON.stringify({\n   349→          to: ['andrea@andyou.ph', 'karell@andyou.ph', 'bryan_bumanglag@andyou.ph'],\n   350→ 