{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011TPCWXEsWmEUwAFoEFZMGd","type":"tool_result","content":"     1→import React, { useState, useEffect } from 'react';\n     2→import ReactDOM from 'react-dom/client';\n     3→import { LineChart, Line, BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, ReferenceLine, Legend } from 'recharts';\n     4→import { createClient } from '@supabase/supabase-js';\n     5→\n     6→const supabaseUrl = import.meta.env.VITE_INVENTORY_SUPABASE_URL;\n     7→const supabaseKey = import.meta.env.VITE_INVENTORY_SUPABASE_ANON_KEY;\n     8→const supabase = supabaseUrl && supabaseKey ? createClient(supabaseUrl, supabaseKey) : null;\n     9→\n    10→const C = {\n    11→  bg: \"#FAF9F7\",\n    12→  accent: \"#AF6E4C\",\n    13→  dark: \"#101312\",\n    14→  gray: \"#6B7280\",\n    15→  green: \"#059669\",\n    16→  red: \"#DC2626\",\n    17→  yellow: \"#D97706\",\n    18→  beige: \"#E8E4DF\",\n    19→  cream: \"#F5F3F0\",\n    20→  blue: \"#3B82F6\",\n    21→};\n    22→\n    23→function App() {\n    24→  const [approvedOrders, setApprovedOrders] = useState([]);\n    25→  const [notApprovedOrders, setNotApprovedOrders] = useState([]);\n    26→  const [approvedSummary, setApprovedSummary] = useState(null);\n    27→  const [notApprovedSummary, setNotApprovedSummary] = useState(null);\n    28→  const [loading, setLoading] = useState(false);\n    29→  const [sending, setSending] = useState(false);\n    30→  const [message, setMessage] = useState(null);\n    31→  const [lastFetch, setLastFetch] = useState(null);\n    32→  const [configured, setConfigured] = useState(false);\n    33→  const [activeTab, setActiveTab] = useState('approved');\n    34→  const [metrics, setMetrics] = useState(null);\n    35→  const [metricsLoading, setMetricsLoading] = useState(false);\n    36→  const [deliveryFilter, setDeliveryFilter] = useState('all'); // 'all' | 'with_date' | 'due_today' | 'overdue'\n    37→  const [batchMap, setBatchMap] = useState({}); // SKU -> [{ batch_number, expiry_date, quantity }]\n    38→\n    39→  useEffect(() => {\n    40→    fetch('/api/status')\n    41→      .then(r => r.json())\n    42→      .then(data => {\n    43→        setConfigured(data.configured);\n    44→        if (data.configured) {\n    45→          fetchOrders();\n    46→          fetchMetrics();\n    47→        }\n    48→      })\n    49→      .catch(() => setConfigured(false));\n    50→  }, []);\n    51→\n    52→  const fetchOrders = async () => {\n    53→    setLoading(true);\n    54→    setMessage(null);\n    55→    try {\n    56→      const res = await fetch('/api/orders');\n    57→      const data = await res.json();\n    58→      if (data.error) {\n    59→        setMessage({ type: 'error', text: data.error });\n    60→      } else {\n    61→        const approved = data.approved?.orders || [];\n    62→        setApprovedOrders(approved);\n    63→        setApprovedSummary(data.approved?.summary);\n    64→        setNotApprovedOrders(data.notApproved?.orders || []);\n    65→        setNotApprovedSummary(data.notApproved?.summary);\n    66→        setLastFetch(new Date().toLocaleString());\n    67→        fetchBatches(approved);\n    68→        const ac = data.approved?.summary?.count || 0;\n    69→        const nc = data.notApproved?.summary?.count || 0;\n    70→        setMessage({ type: 'success', text: `Found ${ac} approved, ${nc} not approved` });\n    71→      }\n    72→    } catch (e) {\n    73→      setMessage({ type: 'error', text: e.message });\n    74→    }\n    75→    setLoading(false);"}]},"parent_tool_use_id":null,"session_id":"652984ef-afb7-4f4d-8ebb-d98b5eef4f87","uuid":"cd0dd995-29e4-4e35-918b-a37a14a5077b","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/async-orders-dashboard/src/App.jsx","content":"import React, { useState, useEffect } from 'react';\nimport ReactDOM from 'react-dom/client';\nimport { LineChart, Line, BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, ReferenceLine, Legend } from 'recharts';\nimport { createClient } from '@supabase/supabase-js';\n\nconst supabaseUrl = import.meta.env.VITE_INVENTORY_SUPABASE_URL;\nconst supabaseKey = import.meta.env.VITE_INVENTORY_SUPABASE_ANON_KEY;\nconst supabase = supabaseUrl && supabaseKey ? createClient(supabaseUrl, supabaseKey) : null;\n\nconst C = {\n  bg: \"#FAF9F7\",\n  accent: \"#AF6E4C\",\n  dark: \"#101312\",\n  gray: \"#6B7280\",\n  green: \"#059669\",\n  red: \"#DC2626\",\n  yellow: \"#D97706\",\n  beige: \"#E8E4DF\",\n  cream: \"#F5F3F0\",\n  blue: \"#3B82F6\",\n};\n\nfunction App() {\n  const [approvedOrders, setApprovedOrders] = useState([]);\n  const [notApprovedOrders, setNotApprovedOrders] = useState([]);\n  const [approvedSummary, setApprovedSummary] = useState(null);\n  const [notApprovedSummary, setNotApprovedSummary] = useState(null);\n  const [loading, setLoading] = useState(false);\n  const [sending, setSending] = useState(false);\n  const [message, setMessage] = useState(null);\n  const [lastFetch, setLastFetch] = useState(null);\n  const [configured, setConfigured] = useState(false);\n  const [activeTab, setActiveTab] = useState('approved');\n  const [metrics, setMetrics] = useState(null);\n  const [metricsLoading, setMetricsLoading] = useState(false);\n  const [deliveryFilter, setDeliveryFilter] = useState('all'); // 'all' | 'with_date' | 'due_today' | 'overdue'\n  const [batchMap, setBatchMap] = useState({}); // SKU -> [{ batch_number, expiry_date, quantity }]\n\n  useEffect(() => {\n    fetch('/api/status')\n      .then(r => r.json())\n      .then(data => {\n        setConfigured(data.configured);\n        if (data.configured) {\n          fetchOrders();\n          fetchMetrics();\n        }\n      })\n      .catch(() => setConfigured(false));\n  }, []);\n\n  const fetchOrders = async () => {\n    setLoading(true);\n    setMessage(null);\n    try {\n      const res = await fetch('/api/orders');\n      const data = await res.json();\n      if (data.error) {\n        setMessage({ type: 'error', text: data.error });\n      } else {\n        const approved = data.approved?.orders || [];\n        setApprovedOrders(approved);\n        setApprovedSummary(data.approved?.summary);\n        setNotApprovedOrders(data.notApproved?.orders || []);\n        setNotApprovedSummary(data.notApproved?.summary);\n        setLastFetch(new Date().toLocaleString());\n        fetchBatches(approved);\n        const ac = data.approved?.summary?.count || 0;\n        const nc = data.notApproved?.summary?.count || 0;\n        setMessage({ type: 'success', text: `Found ${ac} approved, ${nc} not approved` });\n      }\n    } catch (e) {\n      setMessage({ type: 'error', text: e.message });\n    }\n    setLoading(false);","numLines":75,"startLine":1,"totalLines":938}}}
