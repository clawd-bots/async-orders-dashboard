ers.length,\n   390→      awaitingUpsell: awaitingUpsellOrders.length,\n   391→      overdueCount: overdueOrders.length\n   392→    });\n   393→\n   394→  } catch (error) {\n   395→    console.error('Error:', error);\n   396→    res.status(500).json({ error: error.message });\n   397→  }\n   398→}\n   399→"}]},"parent_tool_use_id":"toolu_01KHFL1MSzJQsR3HBYUXN3PJ","session_id":"652984ef-afb7-4f4d-8ebb-d98b5eef4f87","uuid":"e41879fa-8ee5-4d6f-8706-c12d0dbe8c2b"}
