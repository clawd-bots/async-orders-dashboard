{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TpWsiveo6dnysaAFDydZPY","type":"tool_result","content":"     1→// Fetch Shopify orders: Approved to ship but not fulfilled\n     2→export default async function handler(req, res) {\n     3→  const storeUrl = process.env.SHOPIFY_STORE_URL;\n     4→  const accessToken = process.env.SHOPIFY_ACCESS_TOKEN;\n     5→  \n     6→  if (!storeUrl || !accessToken) {\n     7→    return res.status(400).json({ \n     8→      error: 'Shopify API not configured. Set SHOPIFY_STORE_URL and SHOPIFY_ACCESS_TOKEN in Vercel.' \n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    // Use GraphQL to fetch orders with metafields\n    14→    const graphqlUrl = `https://${storeUrl}/admin/api/2024-01/graphql.json`;\n    15→    \n    16→    // Fetch ALL orders using cursor-based pagination\n    17→    let allOrders = [];\n    18→    let hasNextPage = true;\n    19→    let cursor = null;\n    20→\n    21→    while (hasNextPage) {\n    22→      const query = `\n    23→        {\n    24→          orders(first: 250, sortKey: CREATED_AT, reverse: true, query: \"fulfillment_status:unfulfilled financial_status:paid\"${cursor ? `, after: \"${cursor}\"` : \"\"}) {\n    25→            pageInfo {\n    26→              hasNextPage\n    27→              endCursor\n    28→            }\n    29→            edges {\n    30→              node {\n    31→                id\n    32→                name\n    33→                createdAt\n    34→                totalPriceSet {\n    35→                  shopMoney {\n    36→                    amount\n    37→                    currencyCode\n    38→                  }\n    39→                }\n    40→                tags\n    41→                customer {\n    42→                  firstName\n    43→                  lastName\n    44→                  email\n    45→                }\n    46→                shippingAddress {\n    47→                  phone\n    48→                  address1\n    49→                  address2\n    50→                  city\n    51→                  province\n    52→                  provinceCode\n    53→                  zip\n    54→                  country\n    55→                }\n    56→                lineItems(first: 10) {\n    57→                  edges {\n    58→                    node {\n    59→                      title\n    60→                      variantTitle\n    61→                      quantity\n    62→                      sku\n    63→                      fulfillableQuantity\n    64→                      product {\n    65→                        productType\n    66→                      }\n    67→                    }\n    68→                  }\n    69→                }\n    70→                metafield(namespace: \"custom\", key: \"approved_to_ship\") {\n    71→                  value\n    72→                  updatedAt\n    73→                }\n    74→                preferredDeliveryMetafield: metafield(namespace: \"custom\", key: \"preferred_delivery\") {\n    75→                  value\n    76→                }\n    77→                preferredDeliveryDateMetafield: metafield(namespace: \"custom\", key: \"preferred_delivery_data\") {\n    78→                  value\n    79→                }\n    80→                prescriptionStatusMetafield: metafield(namespace: \"custom\", key: \"prescription_status\") {\n    81→                  value\n    82→                }\n    83→                consultationStatusMetafield: metafield(namespace: \"custom\", key: \"consultation_status\") {\n    84→                  value\n    85→                  updatedAt\n    86→                }\n    87→                orderStatusMetafield: metafield(namespace: \"custom\", key: \"order_status\") {\n    88→                  value\n    89→                }\n    90→                discountCodes\n    91→              }\n    92→            }\n    93→          }\n    94→        }\n    95→      `;\n    96→\n    97→      const response = await fetch(graphqlUrl, {\n    98→        method: 'POST',\n    99→        headers: {\n   100→          'X-Shopify-Access-Token': accessToken,\n   101→          'Content-Type': 'application/json'\n   102→        },\n   103→        body: JSON.stringify({ query })\n   104→      });\n   105→\n   106→      if (!response.ok) {\n   107→        const error = await response.text();\n   108→        console.error('Shopify GraphQL error:', error);\n   109→        return res.status(response.status).json({ \n   110→          error: `Shopify API error: ${response.status}` \n   111→        });\n   112→      }\n   113→\n   114→      const data = await response.json();\n   115→      \n   116→      if (data.errors) {\n   117→        console.error('GraphQL errors:', data.errors);\n   118→        return res.status(400).json({ error: data.errors[0]?.message || 'GraphQL error' });\n   119→      }\n   120→\n   121→      const pageOrders = data.data?.orders?.edges || [];\n   122→      allOrders = allOrders.concat(pageOrders);\n   123→      \n   124→      hasNextPage = data.data?.orders?.pageInfo?.hasNextPage || false;\n   125→      cursor = data.data?.orders?.pageInfo?.endCursor || null;\n   126→    }\n   127→\n   128→    // Filter out Keevtest discount codes, include approved_to_ship status and new metafields\n   129→    const filteredOrders = allOrders\n   130→      .filter(edge => {\n   131→        // Exclude orders with Keevtest discount code\n   132→        const discountCodes = edge.node.discountCodes || [];\n   133→        const hasKeevtest = discountCodes.some(code => \n   134→          code?.toLowerCase?.().includes('keevtest')\n   135→        );\n   136→        if (hasKeevtest) return false;\n   137→        \n   138→        // Exclude orders with Order Status = \"Manually Refunded\"\n   139→        const orderStatus = edge.node.orderStatusMetafield?.value?.toLowerCase?.() || '';\n   140→        if (orderStatus.includes('manually refunded')) return false;\n   141→        \n   142→        return true;\n   143→      })\n   144→      .map(edge => {\n   145→        const node = edge.node;\n   146→        const metafield = node.metafield;\n   147→        const val = metafield?.value?.toLowerCase?.() || '';\n   148→        \n   149→        // Three states: true (approved), false (explicitly not approved), null (empty/not set)\n   150→        let approvedToShip = null;\n   151→        if (val === 'true' || val === '1' || val === 'yes') {\n   152→          approvedToShip = true;\n   153→        } else if (val === 'false' || val === '0' || val === 'no') {\n   154→          approvedToShip = false;\n   155→        }\n   156→        // If val is empty string, approvedToShip stays null\n   157→        const approvedAt = approvedToShip === true ? (metafield?.updatedAt || null) : null;\n   158→        \n   159→        // Parse preferred delivery metafield (True/False/Blank)\n   160→        const preferredDeliveryVal = node.preferredDeliveryMetafield?.value?.toLowerCase?.() || '';\n   161→        let preferredDelivery = null;\n   162→        if (preferredDeliveryVal === 'true' || preferredDeliveryVal === '1' || preferredDeliveryVal === 'yes') {\n   163→          preferredDelivery = true;\n   164→        } else if (preferredDeliveryVal === 'false' || preferredDeliveryVal === '0' || preferredDeliveryVal === 'no') {\n   165→          preferredDelivery = false;\n   166→        }\n   167→        \n   168→        return {\n   169→          id: node.id,\n   170→          name: node.name,\n   171→          created_at: node.createdAt,\n   172→          total_price: node.totalPriceSet?.shopMoney?.amount,\n   173→          currency: node.totalPriceSet?.shopMoney?.currencyCode,\n   174→          approved_to_ship: approvedToShip,\n   175→          approved_at: approvedAt,\n   176→          preferred_delivery: preferredDelivery,\n   177→          preferred_delivery_date: node.preferredDeliveryDateMetafield?.value || null,\n   178→          prescription_status: node.prescriptionStatusMetafield?.value || null,\n   179→          consultation_status: (() => {\n   180→            try {\n   181→              const raw = node.consultationStatusMetafield?.value;\n   182→              if (!raw) return null;\n   183→              const parsed = JSON.parse(raw);\n   184→              return Array.isArray(parsed) ? parsed[0] : parsed;\n   185→            } catch { return node.consultationStatusMetafield?.value || null; }\n   186→          })(),\n   187→          consultation_status_updated_at: node.consultationStatusMetafield?.updatedAt || null,\n   188→          tags: node.tags || [],\n   189→          is_provincial: (node.tags || []).some(t => t.toLowerCase() === 'provincial'),\n   190→          customer: {\n   191→            first_name: node.customer?.firstName,\n   192→            last_name: node.customer?.lastName,\n   193→            email: node.customer?.email\n   194→          },\n   195→          shipping_address: node.shippingAddress ? {\n   196→            phone: node.shippingAddress.phone || '',\n   197→            address1: node.shippingAddress.address1 || '',\n   198→            address2: node.shippingAddress.address2 || '',\n   199→            city: node.shippingAddress.city || '',\n   200→            province: node.shippingAddress.province || '',\n   201→            zip: node.shippingAddress.zip || '',\n   202→          } : null,\n   203→          line_items: (node.lineItems?.edges?.map(e => ({\n   204→            title: e.node.variantTitle && e.node.variantTitle !== 'Default Title' ? `${e.node.title} — ${e.node.variantTitle}` : e.node.title,\n   205→            quantity: e.node.fulfillableQuantity ?? e.node.quantity,\n   206→            original_quantity: e.node.quantity,\n   207→            sku: e.node.sku || '',\n   208→            fulfillable_quantity: e.node.fulfillableQuantity ?? e.node.quantity,\n   209→            product_type: e.node.product?.productType || ''\n   210→          })) || []).filter(li => li.fulfillable_quantity > 0)\n   211→        };\n   212→      });\n   213→    \n   214→    const approvedOrders = filteredOrders.filter(o => o.approved_to_ship === true);\n   215→    const notApprovedOrders = filteredOrders.filter(o => {\n   216→      if (o.approved_to_ship !== false) return false;\n   217→      const ps = o.prescription_status || '';\n   218→      if (ps.toLowerCase().includes('on hold') || ps.toLowerCase().includes('on_hold')) return false;\n   219→      return true;\n   220→    });\n   221→\n   222→    // Sort by created_at descending (newest first)\n   223→    approvedOrders.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\n   224→    notApprovedOrders.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\n   225→\n   226→    // Calculate totals for approved\n   227→    const approvedValue = approvedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n   228→    const approvedItems = approvedOrders.reduce((sum, o) => \n   229→      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n   230→    \n   231→    // Calculate totals for not approved\n   232→    const notApprovedValue = notApprovedOrders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);\n   233→    const notApprovedItems = notApprovedOrders.reduce((sum, o) => \n   234→      sum + (o.line_items?.reduce((s, i) => s + i.quantity, 0) || 0), 0);\n   235→\n   236→    res.json({ \n   237→      approved: {\n   238→        orders: approvedOrders,\n   239→        summary: {\n   240→          count: approvedOrders.length,\n   241→          totalValue: approvedValue.toFixed(2),\n   242→          totalItems: approvedItems,\n   243→          currency: approvedOrders[0]?.currency || 'PHP'\n   244→        }\n   245→      },\n   246→      notApproved: {\n   247→        orders: notApprovedOrders,\n   248→        summary: {\n   249→          count: notApprovedOrders.length,\n   250→          totalValue: notApprovedValue.toFixed(2),\n   251→          totalItems: notApprovedItems,\n   252→          currency: notApprovedOrders[0]?.currency || 'PHP'\n   253→        }\n   254→      },\n   255→      fetchedAt: new Date().toISOString()\n   256→    });\n   257→    \n   258→  } catch (error) {\n   259→    console.error('Error fetching orders:', error);\n   260→    res.status(500).json({ error: error.message });\n   261→  }\n   262→}\n   263→"}]},"parent_tool_use_id":"toolu_01UmcsT2WX13i99KmBZ714Hk","session_id":"652984ef-afb7-4f4d-8ebb-d98b5eef4f87","uuid":"a4ae0027-f4f7-4e9e-87f0-c8fd98879c19"}
