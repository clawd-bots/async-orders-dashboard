{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WLhAoss73jaUwv1Rj8jP5G","type":"tool_result","content":"   640→              <div style={{ height: 200, display: 'flex', alignItems: 'center', justifyContent: 'center', color: C.gray, fontSize: 13 }}>\n   641→                {metricsLoading ? 'Loading metrics...' : 'No data yet'}\n   642→              </div>\n   643→            )}\n   644→            <div style={{ fontSize: 10, color: C.gray, marginTop: 6, display: 'flex', alignItems: 'center', gap: 8 }}>\n   645→              <span style={{ display: 'inline-block', width: 8, height: 8, borderRadius: '50%', background: '#e9967a', border: '1.5px solid #c0392b' }}></span>\n   646→              Mondays — times include Sunday (no fulfillment)\n   647→            </div>\n   648→          </div>\n   649→\n   650→          {/* Orders Fulfilled Per Day (MTD) */}\n   651→          <div style={{ background: '#fff', borderRadius: 12, padding: 20, border: `1px solid ${C.beige}` }}>\n   652→            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 4 }}>\n   653→              <div style={{ fontSize: 14, fontWeight: 600, color: C.dark }}>Orders Fulfilled Per Day</div>\n   654→              {(avgMetroPerDay > 0 || avgProvincialPerDay > 0) && (\n   655→                <div style={{ textAlign: 'right' }}>\n   656→                  <div style={{ fontSize: 20, fontWeight: 700, color: C.dark }}>{(avgMetroPerDay + avgProvincialPerDay).toFixed(0)} avg/day</div>\n   657→                  <div style={{ fontSize: 11, color: C.gray }}>({avgMetroPerDay.toFixed(0)} metro · {avgProvincialPerDay.toFixed(0)} provincial)</div>\n   658→                </div>\n   659→              )}\n   660→            </div>\n   661→            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 }}>\n   662→              <div style={{ fontSize: 11, color: C.gray }}>Provincial vs Metro · Excludes Sundays</div>\n   663→            </div>\n   664→            {fulfilledData.length > 0 ? (\n   665→              <ResponsiveContainer width=\"100%\" height={200}>\n   666→                <BarChart data={fulfilledData}>\n   667→                  <CartesianGrid strokeDasharray=\"3 3\" stroke={C.beige} />\n   668→                  <XAxis dataKey=\"date\" tick={{ fontSize: 10, fill: C.gray }} tickFormatter={v => v.slice(5)} />\n   669→                  <YAxis tick={{ fontSize: 10, fill: C.gray }} />\n   670→                  <Tooltip\n   671→                    contentStyle={{ fontSize: 12, borderRadius: 8 }}\n   672→                    labelFormatter={(v) => v}\n   673→                  />\n   674→                  <Legend wrapperStyle={{ fontSize: 11 }} />\n   675→                  <Bar dataKey=\"metro\" stackId=\"a\" fill={C.accent} name=\"Metro\" />\n   676→                  <Bar dataKey=\"provincial\" stackId=\"a\" fill={C.yellow} name=\"Provincial\" radius={[4, 4, 0, 0]} />\n   677→                </BarChart>\n   678→              </ResponsiveContainer>\n   679→            ) : (\n   680→              <div style={{ height: 200, display: 'flex', alignItems: 'center', justifyContent: 'center', color: C.gray, fontSize: 13 }}>\n   681→                {metricsLoading ? 'Loading metrics...' : 'No data yet'}\n   682→              </div>\n   683→            )}\n   684→          </div>\n   685→        </div>\n   686→\n   687→        {/* Actions */}\n   688→        <div style={{\n   689→          background: '#fff', borderRadius: 12, padding: 20, marginBottom: 20,\n   690→          border: `1px solid ${C.beige}`\n   691→        }}>\n   692→          <div style={{ display: 'flex', gap: 12, flexWrap: 'wrap' }}>\n   693→            <button onClick={() => { fetchOrders(); fetchMetrics(); }} disabled={loading || !configured}\n   694→              style={{\n   695→                padding: '12px 24px', borderRadius: 8, border: 'none',\n   696→                background: C.accent, color: '#fff', fontWeight: 600, fontSize: 14,\n   697→                cursor: loading || !configured ? 'not-allowed' : 'pointer',\n   698→                opacity: loading || !configured ? 0.6 : 1\n   699→              }}>\n   700→              {loading ? 'Fetching...' : '🔄 Refresh'}\n   701→            </button>\n   702→            <button onClick={sendEmail} disabled={sending || !configured}\n   703→              style={{\n   704→                padding: '12px 24px', borderRadius: 8,\n   705→                border: `2px solid ${C.accent}`, background: '#fff',\n   706→                color: C.accent, fontWeight: 600, fontSize: 14,\n   707→                cursor: sending || !configured ? 'not-allowed' : 'pointer',\n   708→                opacity: sending || !configured ? 0.6 : 1\n   709→              }}>\n   710→              {sending ? 'Sending...' : '📧 Send Report'}\n   711→            </button>\n   712→            <button onClick={downloadCSV} disabled={orders.length === 0}\n   713→              style={{\n   714→                padding: '12px 24px', borderRadius: 8,\n   715→                border: `1px solid ${C.beige}`, background: C.cream,\n   716→                color: C.dark, fontWeight: 500, fontSize: 14,\n   717→                cursor: orders.length === 0 ? 'not-allowed' : 'pointer',\n   718→                opacity: orders.length === 0 ? 0.6 : 1\n   719→              }}>\n   720→              ⬇️ Export CSV\n   721→            </button>\n   722→          </div>\n   723→          {lastFetch && <div style={{ marginTop: 12, fontSize: 12, color: C.gray }}>Last updated: {lastFetch}</div>}\n   724→          \n   725→          {/* Tabs */}\n   726→          {(approvedOrders.length > 0 || notApprovedOrders.length > 0) && (\n   727→            <div style={{ marginTop: 16, display: 'flex', gap: 8 }}>\n   728→              <button onClick={() => setActiveTab('approved')}\n   729→                style={{\n   730→                  padding: '10px 20px', borderRadius: 8,\n   731→                  border: activeTab === 'approved' ? `2px solid ${C.green}` : `1px solid ${C.beige}`,\n   732→                  background: activeTab === 'approved' ? '#D1FAE5' : '#fff',\n   733→                  color: activeTab === 'approved' ? C.green : C.dark,\n   734→                  fontWeight: 600, fontSize: 14, cursor: 'pointer'\n   735→                }}>\n   736→                ✓ Approved ({approvedSummary?.count || 0})\n   737→              </button>\n   738→              <button onClick={() => setActiveTab('notApproved')}\n   739→                style={{\n   740→                  padding: '10px 20px', borderRadius: 8,\n   741→                  border: activeTab === 'notApproved' ? `2px solid ${C.red}` : `1px solid ${C.beige}`,\n   742→                  background: activeTab === 'notApproved' ? '#FEE2E2' : '#fff',\n   743→                  color: activeTab === 'notApproved' ? C.red : C.dark,\n   744→                  fontWeight: 600, fontSize: 14, cursor: 'pointer'\n   745→                }}>\n   746→                ✗ Rejected ({notApprovedSummary?.count || 0})\n   747→              </button>\n   748→            </div>\n   749→          )}\n   750→        </div>\n   751→\n   752→        {/* Orders Table */}\n   753→        <div style={{\n   754→          background: '#fff', borderRadius: 12, border: `1px solid ${C.beige}`, overflow: 'hidden'\n   755→        }}>\n   756→          <div style={{\n   757→            padding: '16px 20px', borderBottom: `1px solid ${C.beige}`,\n   758→            display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: 12\n   759→          }}>\n   760→            <div style={{ fontWeight: 600, color: C.dark }}>\n   761→              {activeTab === 'approved' ? 'Approved & Pending Fulfillment' : 'Rejected (For Cancellation/Refund)'} ({orders.length})\n   762→            </div>\n   763→            {activeTab === 'approved' && (\n   764→              <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>\n   765→                {[\n   766→                  { key: 'all', label: 'All', count: approvedOrders.length },\n   767→                  { key: 'due_today', label: 'Due Today', count: dueTodayCount },\n   768→                  { key: 'with_date', label: 'With Delivery Date', count: allWithDateCount },\n   769→                  { key: 'overdue', label: 'Overdue', count: overdueCount },\n   770→                  { key: 'awaiting_consult', label: '⏳ Awaiting Consult', count: awaitingConsultCount },\n   771→                ].map(f => (\n   772→                  <button key={f.key} onClick={() => setDeliveryFilter(f.key)}\n   773→                    style={{\n   774→                      padding: '4px 12px', borderRadius: 16, fontSize: 11, fontWeight: 600, cursor: 'pointer',\n   775→                      border: deliveryFilter === f.key ? `2px solid ${C.accent}` : `1px solid ${C.beige}`,\n   776→                      background: deliveryFilter === f.key ? '#FDF2EC' : '#fff',\n   777→                      color: deliveryFilter === f.key ? C.accent : C.gray,\n   778→                    }}>\n   779→                    {f.label} ({f.count})\n   780→                  </button>\n   781→                ))}\n   782→              </div>\n   783→            )}\n   784→          </div>\n   785→\n   786→          {orders.length === 0 ? (\n   787→            <div style={{ padding: 40, textAlign: 'center', color: C.gray }}>\n   788→              {configured\n   789→                ? (lastFetch\n   790→                  ? (activeTab === 'approved' ? '✅ All approved orders fulfilled!' : '✅ No rejected orders')\n   791→                  : 'Click \"Refresh\" to load')\n   792→                : 'Configure Shopify API to get started'}\n   793→            </div>\n   794→          ) : (\n   795→            <div style={{ maxHeight: 600, overflowY: 'auto', overflowX: 'auto', WebkitOverflowScrolling: 'touch' }}>\n   796→              <table style={{ width: '100%', borderCollapse: 'collapse', minWidth: 800 }}>\n   797→                <thead>\n   798→                  <tr style={{ background: C.cream, position: 'sticky', top: 0, zIndex: 1 }}>\n   799→                    <th style={thStyle}>Order</th>\n   800→                    <th style={thStyle}>Customer</th>\n   801→                    <th style={thStyle}>Product</th>\n   802→                    {activeTab === 'approved' && (\n   803→                      <>\n   804→                        <th style={thStyle}>Batch</th>\n   805→                        <th style={{ ...thStyle, textAlign: 'center' }}>Provincial</th>\n   806→                        <th style={{ ...thStyle, textAlign: 'center' }}>Pref. Delivery</th>\n   807→                        <th style={thStyle}>Delivery Date</th>\n   808→                        <th style={thStyle}>Approved On</th>\n   809→                        <th style={{ ...thStyle, textAlign: 'right' }}>Since Approval</th>\n   810→                      </>\n   811→                    )}\n   812→                    {activeTab === 'notApproved' && (\n   813→                      <>\n   814→                        <th style={thStyle}>Prescription Status</th>\n   815→                        <th style={{ ...thStyle, textAlign: 'right' }}>Total</th>\n   816→                      </>\n   817→                    )}\n   818→                  </tr>\n   819→                </thead>\n   820→                <tbody>\n   821→                  {orders.flatMap((order) => {\n   822→                    const items = order.line_items?.length > 0 ? order.line_items : [{ title: '', sku: '', quantity: 1 }];\n   823→                    // Expand each item by its quantity (1 row per unit)\n   824→                    const expandedRows = items.flatMap((item, itemIdx) =>\n   825→                      Array.from({ length: Math.max(item.quantity || 1, 1) }, (_, unitIdx) => ({\n   826→                        order,\n   827→                        item,\n   828→                        key: `${order.id}-${itemIdx}-${unitIdx}`,\n   829→                      }))\n   830→                    );\n   831→                    return expandedRows;\n   832→                  }).map(({ order, item, key }, i) => {\n   833→                    const waitRef = getEffectiveApprovalDate(order);\n   834→                    const waitHrs = (new Date() - new Date(waitRef)) / (1000 * 60 * 60);\n   835→                    const waitColor = waitHrs > 72 ? C.red : waitHrs > 24 ? C.yellow : C.gray;\n   836→                    const addr = order.shipping_address;\n   837→\n   838→                    return (\n   839→                      <tr key={key} style={{ borderTop: i > 0 ? `1px solid ${C.beige}` : 'none' }}>\n   840→                        <td style={tdStyle}>\n   841→                          <div style={{ fontWeight: 600, color: C.accent }}>{order.name}</div>\n   842→                          <div style={{ fontSize: 11, color: C.gray }}>{new Date(order.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' })}</div>\n   843→                          {isAwaitingConsultation(order) && (\n   844→                            <div style={{ fontSize: 10, color: '#9b59b6', fontWeight: 600, marginTop: 2 }}>⏳ Consult Scheduled</div>\n   845→                          )}\n   846→                        </td>\n   847→                        <td style={tdStyle}>\n   848→                          <div style={{ fontSize: 14 }}>{order.customer?.first_name} {order.customer?.last_name}</div>\n   849→                          {activeTab === 'notApproved' && (\n   850→                            <div style={{ fontSize: 11, color: C.gray }}>{order.customer?.email}</div>\n   851→                          )}\n   852→                        </td>\n   853→                        <td style={{ ...tdStyle, fontSize: 13 }}>\n   854→                          {item.title ? (item.title.length > 45 ? item.title.slice(0, 45) + '...' : item.title) : '—'}\n   855→                        </td>\n   856→                        {activeTab === 'approved' && (\n   857→                          <>\n   858→                            <td style={{ ...tdStyle, fontSize: 12 }}>\n   859→                              {(() => {\n   860→                                const alloc = batchAllocations[i];\n   861→                                if (!alloc) return <span style={{ color: C.red, fontWeight: 600, fontSize: 11 }}>No stock</span>;\n   862→                                const expiryColor = getBatchExpiryColor(alloc.expiry_date);\n   863→                                return (\n   864→                                  <div>\n   865→                                    <div style={{ fontWeight: 600, color: expiryColor, fontSize: 12 }}>{alloc.batch_number}</div>\n   866→                                    <div style={{ fontSize: 10, color: expiryColor }}>\n   867→                                      Exp: {new Date(alloc.expiry_date).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' })}\n   868→                                    </div>\n   869→                                  </div>\n   870→                                );\n   871→                              })()}\n   872→                            </td>\n   873→                            <td style={{ ...tdStyle, textAlign: 'center', fontSize: 12 }}>\n   874→                              {order.is_provincial\n   875→                                ? <span style={{ background: '#FEF3C7', color: C.yellow, padding: '2px 8px', borderRadius: 12, fontWeight: 600, fontSize: 11 }}>Provincial</span>\n   876→                                : <span style={{ color: C.gray }}>Metro</span>}\n   877→                            </td>\n   878→                            <td style={{ ...tdStyle, textAlign: 'center', fontSize: 13 }}>\n   879→                              {order.preferred_delivery === true && <span style={{ color: C.green }}>✓</span>}\n   880→                              {order.preferred_delivery === false && <span style={{ color: C.red }}>✗</span>}\n   881→                              {order.preferred_delivery === null && <span style={{ color: C.gray }}>—</span>}\n   882→                            </td>\n   883→                            <td style={{ ...tdStyle, fontSize: 12 }}>\n   884→                              {order.preferred_delivery_date\n   885→                                ? new Date(order.preferred_delivery_date).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' })\n   886→                                : <span style={{ color: C.gray }}>—</span>}\n   887→                            </td>\n   888→                            <td style={{ ...tdStyle, fontSize: 11, color: C.gray }}>\n   889→                              {(() => {\n   890→                                const effectiveDate = getEffectiveApprovalDate(order);\n   891→                                const cs = order.consultation_status?.toLowerCase();\n   892→                                const wasConsult = order.consultation_status_updated_at && cs && cs !== 'scheduled' && cs !== 'not required';\n   893→                                return effectiveDate ? (\n   894→                                  <>\n   895→                                    {new Date(effectiveDate).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })}\n   896→                                    {wasConsult && <div style={{ fontSize: 9, color: '#9b59b6', marginTop: 1 }}>Post-consult</div>}\n   897→                                  </>\n   898→                                ) : <span style={{ color: C.gray }}>—</span>;\n   899→                              })()}\n   900→                            </td>\n   901→                            <td style={{ ...tdStyle, textAlign: 'right', fontSize: 12, fontWeight: 600, color: waitColor }}>\n   902→                              {getHoursAgo(waitRef)}\n   903→                            </td>\n   904→                          </>\n   905→                        )}\n   906→                        {activeTab === 'notApproved' && (\n   907→                          <>\n   908→                            <td style={{ ...tdStyle, fontSize: 13 }}>\n   909→                              {order.prescription_status || <span style={{ color: C.gray }}>—</span>}\n   910→                            </td>\n   911→                            <td style={{ ...tdStyle, textAlign: 'right', fontWeight: 600 }}>\n   912→                              {order.currency} {parseFloat(order.total_price).toLocaleString()}\n   913→                            </td>\n   914→                          </>\n   915→                        )}\n   916→                      </tr>\n   917→                    );\n   918→                  })}\n   919→                </tbody>\n   920→              </table>\n   921→            </div>\n   922→          )}\n   923→        </div>\n   924→\n   925→        <div style={{ marginTop: 20, padding: 16, background: C.cream, borderRadius: 8, fontSize: 13, color: C.gray }}>\n   926→          <strong>📧 Daily Email:</strong> Sent every day at 8:00 AM PHT with pending fulfillment orders.\n   927→          {' · '}<strong>🕒 Cutoff:</strong> 7:30 AM for all orders, 12:00 PM for Sexual Health (Mon–Sat). No fulfillment on Sundays.\n   928→        </div>\n   929→      </main>\n   930→    </div>\n   931→  );\n   932→}\n   933→\n   934→const thStyle = { padding: '10px 12px', textAlign: 'left', fontSize: 11, color: '#6B7280', fontWeight: 600, whiteSpace: 'nowrap' };\n   935→const tdStyle = { padding: '10px 12px', verticalAlign: 'top' };\n   936→\n   937→ReactDOM.createRoot(document.getElementById('root')).render(<App />);\n   938→"}]},"parent_tool_use_id":null,"session_id":"652984ef-afb7-4f4d-8ebb-d98b5eef4f87","uuid":"5bafd04a-baed-47dc-805b-c161626258a0","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/async-orders-dashboard/src/App.jsx","content"